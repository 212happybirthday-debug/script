-- PlayerCharacterLocationDetector 可視化機能
local function setupPlayerLocationVisual()
    if not playerLocationVisualEnabled then return end
    
    local TARGET_NAME = "PlayerCharacterLocationDetector"
    
    local function addPulse(part)
        local tweenInfo = TweenInfo.new(
            1.2,
            Enum.EasingStyle.Sine,
            Enum.EasingDirection.InOut,
            -1,
            true
        )

        local tween = TweenService:Create(part, tweenInfo, {
            Transparency = 0.35
        })

        tween:Play()
        return tween
    end

    local function addHighlight(part)
        local highlight = Instance.new("Highlight")
        highlight.FillColor = Color3.fromRGB(180, 0, 255)
        highlight.OutlineColor = Color3.fromRGB(255, 120, 255)
        highlight.FillTransparency = 0.6
        highlight.OutlineTransparency = 0
        highlight.Parent = part
        return highlight
    end

    local function visualize(part)
        if not part:IsA("BasePart") then return end

        part.Transparency = 0.15
        part.Color = Color3.fromRGB(160, 0, 255)
        part.Material = Enum.Material.Neon
        part.CanCollide = false

        local pulseTween = addPulse(part)
        local highlight = addHighlight(part)
        
        part:SetAttribute("VisualTween", pulseTween)
        part:SetAttribute("VisualHighlight", highlight)
    end

    local function cleanupVisual(part)
        if part:GetAttribute("VisualTween") then
            part:GetAttribute("VisualTween"):Cancel()
            part:SetAttribute("VisualTween", nil)
        end
        if part:GetAttribute("VisualHighlight") then
            part:GetAttribute("VisualHighlight"):Destroy()
            part:SetAttribute("VisualHighlight", nil)
        end
        if part:IsA("BasePart") then
            part.Transparency = 0
            part.Color = Color3.fromRGB(255, 255, 255)
            part.Material = Enum.Material.Plastic
            part.CanCollide = true
        end
    end

    local descendantAddedConn
    descendantAddedConn = Workspace.DescendantAdded:Connect(function(obj)
        if obj.Name == TARGET_NAME and playerLocationVisualEnabled then
            visualize(obj)
        end
    end)
    table.insert(visualConnections, descendantAddedConn)

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == TARGET_NAME and playerLocationVisualEnabled then
            visualize(obj)
        end
    end
    
    local function disableFunction()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == TARGET_NAME then
                cleanupVisual(obj)
            end
        end
    end
    
    return disableFunction
end

