-- Obey Logic ループ
task.spawn(function()
    while true do
        task.wait()
        if (obeyPartEnabled or obeyAllEnabled) and selectedPlayerName then
            pcall(function()
                local target = Players:FindFirstChild(selectedPlayerName)
                if not (target and target.Character) then 
                    return 
                end
                local char = getChar()
                if obeyPartEnabled then
                    local tPart = GetRepresentativePart(target.Character, selectedPart)
                    local myPart = GetRepresentativePart(char, selectedPart)
                    if tPart and myPart then 
                        myPart.CFrame = myPart.CFrame:Lerp(tPart.CFrame, lerpAlpha) 
                    end
                end
                if obeyAllEnabled then
                    local tHRP = GetRepresentativePart(target.Character, "胴体")
                    if not tHRP then 
                        return 
                    end
                    local offset = tHRP.CFrame.RightVector * obeyRightDistance
                    local keys = {"頭", "左腕", "右腕", "左足", "右足"}
                    for _, key in ipairs(keys) do
                        local tP = GetRepresentativePart(target.Character, key)
                        local myP = GetRepresentativePart(char, key)
                        if tP and myP then
                            local targetPos = tP.Position + offset
                            local newCF = CFrame.new(targetPos) * (myP.CFrame - myP.CFrame.p)
                            myP.CFrame = myP.CFrame:Lerp(newCF, lerpAlpha)
                        end
                    end
                end
            end)
        end
    end
end)

