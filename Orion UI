local function GetRepresentativePart(character, partKey)
    if not character then 
        return nil 
    end
    local function findAny(names)
        for _, n in ipairs(names) do
            local p = character:FindFirstChild(n)
            if p and p:IsA("BasePart") then 
                return p 
            end
        end
        return nil
    end
    if partKey == "頭" then 
        return findAny({"Head"})
    elseif partKey == "胴体" then 
        return findAny({"HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso"})
    elseif partKey == "左腕" then 
        return findAny({"LeftHand", "LeftUpperArm", "Left Arm", "LeftLowerArm"})
    elseif partKey == "右腕" then 
        return findAny({"RightHand", "RightUpperArm", "Right Arm", "RightLowerArm"})
    elseif partKey == "左足" then 
        return findAny({"LeftFoot", "LeftLowerLeg", "Left Leg", "LeftUpperLeg"})
    elseif partKey == "右足" then 
        return findAny({"RightFoot", "RightLowerLeg", "Right Leg", "RightUpperLeg"}) 
    end
    return nil
end

local function GetPart(character, partKey)
    if not character then 
        return {} 
    end
    local names = {}
    if partKey == "HRP" then 
        names = {"HumanoidRootPart", "Torso", "UpperTorso"}
    elseif partKey == "その他" then
        names = {"Head", "Left Arm", "Right Arm", "Left Leg", "Right Leg", 
                 "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", 
                 "LeftHand", "RightHand", "LeftUpperLeg", "RightUpperLeg", 
                 "LeftLowerLeg", "RightLowerLeg", "LeftFoot", "RightFoot"}
    end
    
    local found = {}
    for _, name in ipairs(names) do
        local p = character:FindFirstChild(name)
        if p and p:IsA("BasePart") then 
            table.insert(found, p) 
        end
    end
    return found
end

