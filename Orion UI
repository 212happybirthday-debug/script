local function runTargetKillAura(targetPlayer)
    while targetKillRunning and selectedTargetPlayer == targetPlayer do
        task.wait(0.01)
        local char, hrp = getCharInfo()
        if not hrp then 
            continue 
        end
        
        local target = Players:FindFirstChild(targetPlayer)
        if not target or not target.Character then 
            task.wait(1)
            continue 
        end
        
        local targetChar = target.Character
        local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
        local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
        
        if not (targetHRP and targetHum) or targetHum.Health <= 0 then
            task.wait(1)
            continue
        end
        
        local blobman = spawnBlobmanIfNeeded()
        if not blobman then 
            task.wait(0.5)
            continue 
        end
        
        local seat = blobman:FindFirstChildWhichIsA("VehicleSeat", true)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (seat and hum) then 
            task.wait(0.5)
            continue 
        end
        
        if not seat.Occupant then
            pcall(function()
                seat:Sit(hum)
            end)
            task.wait(0.2)
        end
        
        if not seat.Occupant then
            task.wait(0.5)
            continue
        end
        
        local scriptFolder = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
        local detector = blobman:FindFirstChild("LeftDetector")
        local weld = detector and detector:FindFirstChild("LeftWeld")
        if not (scriptFolder and detector and weld) then 
            task.wait(0.5)
            continue 
        end
        
        local Grab = scriptFolder:FindFirstChild("CreatureGrab")
        local Release = scriptFolder:FindFirstChild("CreatureRelease")
        local Drop = scriptFolder:FindFirstChild("CreatureDrop")
        if not (Grab and Release and Drop) then 
            task.wait(0.5)
            continue 
        end
        
        lastTargetPosition = hrp.CFrame
        pcall(function()
            hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 0, -3)
        end)
        task.wait(0.2)
        
        local startTime = tick()
        while tick() - startTime < 2 and targetKillRunning do
            if not (target and target.Character and targetHum.Health > 0) then 
                break 
            end
            
            if not seat.Occupant then
                break
            end
            
            if (hrp.Position - targetHRP.Position).Magnitude <= 30 then
                pcall(function()
                    Grab:FireServer(detector, targetHRP, weld)
                    Release:FireServer(weld, targetHRP)
                    Drop:FireServer(weld, targetHRP)
                    targetHum.Health = 0
                end)
            end
            task.wait(0.01)
        end
        
        task.wait(0.1)
        if lastTargetPosition then
            pcall(function()
                hrp.CFrame = lastTargetPosition
            end)
        end
        
        if targetHum.Health <= 0 then
            repeat
                task.wait(0.0000000000001)
                if not targetKillRunning then 
                    break 
                end
                target = Players:FindFirstChild(targetPlayer)
            until target and target.Character and target.Character:FindFirstChildOfClass("Humanoid") and target.Character:FindFirstChildOfClass("Humanoid").Health > 0
            
            task.wait(0.0000000000001)
        end
    end
end

