    end
end

local function executeSequence(child)
    if child.Name ~= targetToyName then 
        return 
    end
    currentInstance = child
    local _, hrp, hum = getCharInfo()
    if not (hrp and hum) then 
        return 
    end
    local seat = child:WaitForChild("VehicleSeat", 2) or child:FindFirstChildWhichIsA("VehicleSeat", true)
    if seat and hum then
        pcall(function()
            seat:Sit(hum)
        end)
        local start = tick()
        while tick() - start < ANTI_DURATION and autoRunEnabled do
            pcall(function()
                ragdollRemote:FireServer(hrp, 0)
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end)
            RunService.Heartbeat:Wait()
        end
        local primary = child.PrimaryPart or child:FindFirstChild("HumanoidRootPart", true) or child:FindFirstChild("Part", true)
        if primary and autoRunEnabled then
            pcall(function()
                if primary.SetNetworkOwner then 
                    primary:SetNetworkOwner(LocalPlayer) 
                end
                sethiddenproperty(primary, "NetworkIsSleeping", false)
            end)
        end
        if originalPos then 
            hrp.CFrame = originalPos 
        end
        task.wait(0.1)
        if seat then 
            seat:Destroy() 
        end
    end
end

local function startSystem()
    local _, hrp, _ = getCharInfo()
    if hrp then 
        originalPos = hrp.CFrame 
    end
    if activeConnection then 
        activeConnection:Disconnect() 
    end
    activeConnection = toysFolder.ChildAdded:Connect(function(child)
        task.spawn(function() 
            executeSequence(child) 
        end)
    end)
    task.spawn(function()
        while autoRunEnabled do
            if not currentInstance or not currentInstance.Parent then
                pcall(function() 
                    SpawnToyRemoteFunction:InvokeServer(targetToyName, CFrame.new(SPAWN_POS), Vector3.new(0, -15.716, 0)) 
                end)
            end
            task.wait(1)
        end
    end)
end

local function runAura(withHP, runningFlagGetter)
    local hpToggle = false
    while runningFlagGetter() do
        task.wait(0.01)
        local char, hrp = getCharInfo()
        if not hrp then 
            continue 
        end
        local blobman = spawnBlobmanIfNeeded()
        if not blobman then 
            continue 
        end
        sitOnBlobman(blobman)
        local scriptFolder = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
        local detector = blobman:FindFirstChild("LeftDetector")
        local weld = detector and detector:FindFirstChild("LeftWeld")
        if not (scriptFolder and detector and weld) then 
            continue 
        end
        local Grab, Release, Drop = scriptFolder:FindFirstChild("CreatureGrab"), scriptFolder:FindFirstChild("CreatureRelease"), scriptFolder:FindFirstChild("CreatureDrop")
        if not (Grab and Release and Drop) then 
            continue 
        end
        hpToggle = not hpToggle
        for _, plr in ipairs(Players:GetPlayers()) do
            if not runningFlagGetter() then 
                break 
            end
            if plr ~= LocalPlayer and not isWhitelisted(plr) then
                local c = plr.Character
                local thrp, hum = c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
                if thrp and hum and (hrp.Position - thrp.Position).Magnitude <= 30 then
                    pcall(function()
                        Grab:FireServer(detector, thrp, weld)
                        Release:FireServer(weld, thrp)
                        Drop:FireServer(weld, thrp)
                        if withHP then 
                            hum.Health = hpToggle and 0 or 100 
                        end
                    end)
                end
            end
        end
    end
end

