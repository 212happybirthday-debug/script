                                    pcall(function() 
                                        dRemote:InvokeServer(burger, hrp.CFrame * CFrame.new(0, 2000, 0), Vector3.new(0, 0, 0)) 
                                    end) 
                                end
                                burger:Destroy()
                            elseif hRemote and dRemote then
                                pcall(function()
                                    hRemote:InvokeServer(burger, char)
                                    dRemote:InvokeServer(burger, hrp.CFrame * CFrame.new(0, 2000, 0), Vector3.new(0, 0, 0))
                                end)
                            end
                        end
                    end
                end
            end)
        end
