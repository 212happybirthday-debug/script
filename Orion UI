local function handleChaosGrab(model, enabled)
    pcall(function()
        local part_to_impulse = model:FindFirstChild("GrabPart")
        if part_to_impulse then
            local bodyPosition = Instance.new("BodyPosition")
            bodyPosition.Parent = part_to_impulse
            bodyPosition.MaxForce = Vector3.new(math.huge, math.huge, math.huge)

            local bodyGyro = Instance.new("BodyGyro")
            bodyGyro.Parent = part_to_impulse
            bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)

            task.spawn(function()
                while enabled() do
                    pcall(function()
                        bodyPosition.Position = part_to_impulse.Position + Vector3.new(math.random(-50, 50), math.random(-50, 50), math.random(-50, 50))
                        bodyGyro.CFrame = CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)))
                    end)
                    task.wait(0.1)
                end
                bodyPosition:Destroy()
                bodyGyro:Destroy()
            end)
        end
    end)
end

