        originalColors = {}
    end
    
    return disableFunction
end

-- 手裏剣ESP機能
local function setupShurikenESP()
    if not shurikenESPEnabled then return end
    
    local function HSVtoRGB(h, s, v)
        local c = v * s
        local x = c * (1 - math.abs((h / 60) % 2 - 1))
        local m = v - c
        
        local r, g, b
        if h < 60 then
            r, g, b = c, x, 0
        elseif h < 120 then
            r, g, b = x, c, 0
        elseif h < 180 then
            r, g, b = 0, c, x
        elseif h < 240 then
            r, g, b = 0, x, c
        elseif h < 300 then
            r, g, b = x, 0, c
        else
            r, g, b = c, 0, x
        end
        
        return Color3.new(r + m, g + m, b + m)
    end

        local function addESPToPart(part)
        if part:FindFirstChild("RainbowESP") then 
            return nil
        end
        
        local box = Instance.new("BoxHandleAdornment")
        box.Name = "RainbowESP"
        box.Adornee = part
        box.Size = part.Size
        box.AlwaysOnTop = true
        box.ZIndex = 10
        box.Transparency = 0.3
        box.Color3 = Color3.new(1, 0, 0)
        box.Parent = part
        
        return box
    end
    local function createESPForShuriken(shuriken)
        if espObjects[shuriken] then return end
        
        local boxes = {}
        
        for _, child in ipairs(shuriken:GetDescendants()) do
            if child:IsA("BasePart") then
                local box = addESPToPart(child)
                if box then
                    table.insert(boxes, box)
                end
            end
        end
        
        if #boxes > 0 then
            espObjects[shuriken] = boxes
        end
    end

    local function removeESPFromShuriken(shuriken)
        if not espObjects[shuriken] then return end
        
        for _, box in ipairs(espObjects[shuriken]) do
            if box then
                box:Destroy()
            end
        end
        
        espObjects[shuriken] = nil
    end

    local function findAndESPShurikens()
        local foundShurikens = {}
        
        for _, player in ipairs(Players:GetPlayers()) do
            local folder = Workspace:FindFirstChild(player.Name .. "SpawnedInToys")
            if folder then
                for _, item in ipairs(folder:GetChildren()) do
                    if item:IsA("Model") and (item.Name == "CreatureBlobman" or item.Name == "AntiKick") then
                        foundShurikens[item] = true
                        createESPForShuriken(item)
                    end
                end
            end
        end
        
        local plotItems = Workspace:FindFirstChild("PlotItems")
        if plotItems then
            for _, plot in ipairs(plotItems:GetChildren()) do
                for _, item in ipairs(plot:GetDescendants()) do
                    if item:IsA("Model") and (item.Name == "CreatureBlobman" or item.Name == "AntiKick") then
                        foundShurikens[item] = true
                        createESPForShuriken(item)
                    end
                end
            end
        end
        
        for shuriken, _ in pairs(espObjects) do
            if not foundShurikens[shuriken] or not shuriken.Parent then
                removeESPFromShuriken(shuriken)
            end
        end
    end

    local espUpdateConn
    espUpdateConn = RunService.Heartbeat:Connect(function()
        if not shurikenESPEnabled then return end
        findAndESPShurikens()
    end)
    table.insert(visualConnections, espUpdateConn)
    
    local rainbowConn
    rainbowConn = RunService.RenderStepped:Connect(function(dt)
        if not shurikenESPEnabled then return end
        
        rainbowHue = (rainbowHue + (dt * 60 * rainbowSpeedESP)) % 360
        local rainbowColor = HSVtoRGB(rainbowHue, 1, 1)
        
        for _, boxes in pairs(espObjects) do
            for _, box in ipairs(boxes) do
                if box and box.Parent then
                    box.Color3 = rainbowColor
                end
            end
        end
    end)
    table.insert(visualConnections, rainbowConn)
    
    local function disableFunction()
        for shuriken, _ in pairs(espObjects) do
            removeESPFromShuriken(shuriken)
        end
        espObjects = {}
    end
    
    return disableFunction
end

