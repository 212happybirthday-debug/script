-- RenderStepped ループ
local angle = 0
RunService.RenderStepped:Connect(function(dt)
    -- Wings Logic
    if WingsActive and #Wings > 0 then
        pcall(function()
            local Char = LocalPlayer.Character
            local torso = Char and (Char:FindFirstChild("Torso") or Char:FindFirstChild("UpperTorso"))
            if torso and Char:FindFirstChild("HumanoidRootPart") then
                TimeCounter += dt * (WingSpeed + Char.HumanoidRootPart.Velocity.Magnitude / 40)
                for i, Wing in ipairs(Wings) do
                    local direction = (i == 1) and 1 or -1
                    local flap = math.sin(TimeCounter) * math.rad(WingAngle + (Char.HumanoidRootPart.Velocity.Magnitude/4)) * direction
                    Wing.Handle.CFrame = torso.CFrame * Offsets[i] * CFrame.Angles(0, 0, flap)
                    if Wing.Reserved then
                        Wing.Reserved.BP.Position = Wing.Handle.Position
                        Wing.Reserved.BG.CFrame = Wing.Handle.CFrame * CFrame.Angles(math.rad(90), 0, math.rad(90))
                    end
                    for Index, Segment in ipairs(Wing.Segments) do
                        local ToFollow = (Index == 1) and Wing.Handle.CFrame or Wing.Segments[Index-1].Part.CFrame
                        Segment.Part.CFrame = Segment.Part.CFrame:Lerp(ToFollow * Offsets[i], 0.5)
                        if Wing.Sync[Index] then
                            Wing.Sync[Index].BP.Position = Segment.Part.Position
                            Wing.Sync[Index].BG.CFrame = Segment.Part.CFrame * CFrame.Angles(math.rad(90), 0, math.rad(90))
                        end
                    end
                end
            end
        end)
    end

    -- Body Head Spin Logic
    if headEnabled then
        pcall(function()
            local char = getChar()
            local hrp = GetRepresentativePart(char, "胴体")
            local head = GetRepresentativePart(char, "頭")
            if hrp and head then
                angle = angle + speed * dt
                local center = hrp.Position
                local x = center.X + math.cos(angle) * radius
                local z = center.Z + math.sin(angle) * radius
                local newCFrame = CFrame.new(Vector3.new(x, center.Y + height, z)) * (head.CFrame - head.CFrame.p)
                head.CFrame = newCFrame
            end
        end)
    end
    
    -- Character Spin Logic (新コードで既に処理済みのため、重複を避ける)
    -- 新コードのRunService.RenderSteppedで処理されているのでコメントアウト
    -- if characterSpinEnabled then ... end
end)

