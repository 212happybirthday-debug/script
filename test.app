local megaRagdollCount = 0
local megaIsHeld = LocalPlayer:WaitForChild("IsHeld")
local megaStruggleAG = game:GetService("ReplicatedStorage"):WaitForChild("CharacterEvents"):WaitForChild("Struggle")
local megaRagdollAG  = game:GetService("ReplicatedStorage"):WaitForChild("CharacterEvents"):WaitForChild("RagdollRemote")

invulnerabilitySection:AddToggle({
    Name = "Anti-Grab",
    Default = false,
    Callback = function(value)
        megaAntiGrabToggle = value

        if value then
            task.spawn(function()
                while megaAntiGrabToggle do
                    pcall(function()
                        megaStruggleAG:FireServer(LocalPlayer)
                    end)
                    megaRagdollCount = 0
                    task.wait(0.1)
                end
            end)

            local function AntiGrabT(character)
                local hrp  = character:WaitForChild("HumanoidRootPart", 10)
                local hum  = character:WaitForChild("Humanoid", 10)
                local head = character:WaitForChild("Head", 10)
                if not (hrp and hum and head) then return end

                head.ChildAdded:Connect(function(child)
                    if child.Name ~= "PartOwner" or not megaAntiGrabToggle then return end

                    hum.Sit = false

                    if megaRagdollCount < 100 then
                        megaRagdollAG:FireServer(hrp, 0)
                        megaRagdollCount = megaRagdollCount + 1
                    end

                    if not megaAntiGrabProce then
                        megaAntiGrabProce = true
                        hrp.Anchored = true

                        local isHeld = LocalPlayer:WaitForChild("IsHeld", 5)
                        while megaAntiGrabToggle and (not isHeld or not isHeld.Value) do
                            task.wait()
                        end

                        local renderConnection = game:GetService("RunService").RenderStepped:Connect(function()
                            hrp.CFrame = hrp.CFrame + hum.MoveDirection * 0.3
                        end)

                        while megaAntiGrabToggle and isHeld and isHeld.Value do
                            task.wait()
                        end

                        renderConnection:Disconnect()
                        hrp.Anchored = false
                        megaAntiGrabProce = false
                    end
                end)
            end

            if LocalPlayer.Character then task.spawn(AntiGrabT, LocalPlayer.Character) end
            LocalPlayer.CharacterAdded:Connect(AntiGrabT)
        end
    end,
    Save = true,
    Flag = "antigrab_toggle"
})

