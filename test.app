		Name = "Lag Server",
		CurrentValue = false,
		Callback = function(Value)
			laggg = Value
			while laggg do
				for b=0,N.Lag_Intensity do
					O.Events.CreateGrabEvent:FireServer(S.w.SpawnLocation,S.w.SpawnLocation.CFrame)
				end
				task.wait(1)
			end 
		end
	})

	lagtab:CreateSlider({
		Name = "Lag Intensity Slider",
		Range = {1, 404},
		Increment = 1,
		Suffix = "Create Grab Per Second*10",
