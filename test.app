    if not config.Blobman.Target then return end
    local root = config.Blobman.Target.Character and config.Blobman.Target.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local blob = getBlobman()
    if not blob then return end
    local pos = HRP().CFrame
    task.wait(0.5)
    HRP().CFrame = root.CFrame
    task.wait()
    blobKick(blob, root, config.Blobman.ArmSide)
    task.wait(0.5)
    HRP().CFrame = pos
end})

local function sitOnBlobman(blob)
    local hum = getHum()
    local seat = blob:FindFirstChildWhichIsA("VehicleSeat", true)
    if seat and hum then
        seat:Sit(hum)
        task.wait(0.4)
        return true
    end
    return false
end

local function ensureBlobmanAndSit()
    local blob = getBlobman()
    if not blob then
        spawntoy("CreatureBlobman", HRP().CFrame * CFrame.new(0, 0, -6))
        task.wait(0.7)
        blob = getBlobman()
    end
    if blob and not blob:FindFirstChild("Sitted") then
        if sitOnBlobman(blob) then
            local marker = Instance.new("BoolValue")
            marker.Name = "Sitted"
            marker.Parent = blob
        end
    end
    return blob
end

Tab4:AddButton({Name = "キックオール", Callback = function()
    local targets = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(targets, p)
        end
    end
    if #targets == 0 then
        OrionLib:MakeNotification({Name = "エラー", Content = "キック可能なプレイヤーが見つかりません", Image = "rbxassetid://4483345998", Time = 3})
        return
    end
    local blob = ensureBlobmanAndSit()
    if not blob then
        OrionLib:MakeNotification({Name = "エラー", Content = "ブロブマンの準備に失敗しました", Image = "rbxassetid://4483345998", Time = 4})
        return
    end
    local myHRP = HRP()
    if not myHRP then return end
    for _, target in ipairs(targets) do
        local tRoot = target.Character.HumanoidRootPart
        myHRP.CFrame = tRoot.CFrame * CFrame.new(0, 0, -1.8)
        task.wait(0.05)
        for i = 1, 3 do
            pcall(function()
                blob.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(blob.LeftDetector, tRoot, blob.LeftDetector.LeftWeld)
            end)
            pcall(function()
                blob.BlobmanSeatAndOwnerScript.CreatureRelease:FireServer(blob.LeftDetector.LeftWeld)
            end)
            task.wait(0.08)
        end
    end
    myHRP.CFrame = CFrame.new(0, 105, 0)
    task.wait(0.15)
    local radius = 17
    local center = CFrame.new(0, 110, 0)
    for i, plr in ipairs(targets) do
        local ang = math.rad((i-1) * (360 / #targets))
        local x = radius * math.cos(ang)
        local z = radius * math.sin(ang)
        pcall(function()
            plr.Character.HumanoidRootPart.CFrame = CFrame.new(center.Position + Vector3.new(x, 0, z))
        end)
    end
    task.wait(0.12)
    local GrabEvents = RS:FindFirstChild("GrabEvents")
    local SetNet = GrabEvents and GrabEvents:FindFirstChild("SetNetworkOwner")
    local DestroyLine = GrabEvents and GrabEvents:FindFirstChild("DestroyGrabLine")
    if SetNet and DestroyLine then
        for _ = 1, 2 do
            for _, plr in ipairs(targets) do
                local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    pcall(function()
                        SetNet:FireServer(root, myHRP.CFrame)
                        DestroyLine:FireServer(root)
                    end)
                end
            end
            task.wait(0.09)
        end
    end
    task.wait(0.35)
    for _, plr in ipairs(targets) do
        local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if root then
            pcall(function()
                blob.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(blob.LeftDetector, root, blob.LeftDetector.LeftWeld)
            end)
            pcall(function()
                blob.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(blob.RightDetector, root, blob.RightDetector.RightWeld)
            end)
        end
    end
    OrionLib:MakeNotification({Name = "成功", Content = #targets .. "人のプレイヤーをキックしました", Image = "rbxassetid://4483345998", Time = 5})
end})

