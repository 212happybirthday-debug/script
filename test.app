local blitzSelectedPlayers = {}
local blitzSelectedLabel

local function updateBlitzSelectedList()
    if #blitzSelectedPlayers == 0 then
        if blitzSelectedLabel then
            blitzSelectedLabel:Set("Selected: None")
        end
    else
        if blitzSelectedLabel then
            blitzSelectedLabel:Set("Selected: " .. table.concat(blitzSelectedPlayers, ", "))
        end
    end
end

local function updateBlitzPlayerList()
    local options = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LP and not table.find(blitzSelectedPlayers, player.Name) then
            table.insert(options, player.Name .. " (" .. player.DisplayName .. ")")
        end
    end
    table.sort(options)
    return options
end

local blitzPlayerDropdown = LoopTab:AddDropdown({
    Name = "プレイヤー選択",
    Options = updateBlitzPlayerList(),
    Callback = function(value)
        local playerName = string.split(value, " ")[1]
        local player = Players:FindFirstChild(playerName)
        
        if player and not table.find(blitzSelectedPlayers, playerName) then
            table.insert(blitzSelectedPlayers, playerName)
            updateBlitzSelectedList()
            blitzPlayerDropdown:Refresh(updateBlitzPlayerList(), true)
        end
    end
})

blitzSelectedLabel = LoopTab:AddLabel("Selected: None")

LoopTab:AddButton({
    Name = "選択リセット",
    Callback = function()
        blitzSelectedPlayers = {}
        updateBlitzSelectedList()
        blitzPlayerDropdown:Refresh(updateBlitzPlayerList(), true)
    end
})

LoopTab:AddToggle({
    Name = "Kill Selected Players",
    Default = false,
    Color = Color3.fromRGB(255, 255, 0),
    Callback = function(v)
        Config.Blitz.IsKilling = v
        
        if v then
            task.spawn(function()
                while Config.Blitz.IsKilling do
                    for i = #blitzSelectedPlayers, 1, -1 do
                        if not Config.Blitz.IsKilling then break end
                        
                        local playerName = blitzSelectedPlayers[i]
                        local targetPlayer = Players:FindFirstChild(playerName)
                        
                        if targetPlayer then
                            if IsValidTarget(targetPlayer) then
                                KillPlayer(targetPlayer)
                            end
                        else
                            table.remove(blitzSelectedPlayers, i)
                            updateBlitzSelectedList()
                        end
                    end
                    task.wait(0.2)
                end
            end)
        end
    end
})

LoopTab:AddButton({
    Name = "Kill Once",
    Callback = function()
        for _, playerName in ipairs(blitzSelectedPlayers) do
            local targetPlayer = Players:FindFirstChild(playerName)
            if targetPlayer and IsValidTarget(targetPlayer) then
                KillPlayer(targetPlayer)
                task.wait(0.5)
            end
        end
    end
})

LoopTab:AddToggle({
    Name = "Bring Selected Players",
    Default = false,
    Color = Color3.fromRGB(255, 255, 0),
    Callback = function(v)
        Config.Blitz.IsBringing = v
        
        if v then
            task.spawn(function()
                while Config.Blitz.IsBringing do
                    for i = #blitzSelectedPlayers, 1, -1 do
                        if not Config.Blitz.IsBringing then break end
                        
                        local playerName = blitzSelectedPlayers[i]
                        local targetPlayer = Players:FindFirstChild(playerName)
                        
                        if targetPlayer then
                            if IsValidTarget(targetPlayer) then
                                BringPlayer(targetPlayer)
                            end
                        else
                            table.remove(blitzSelectedPlayers, i)
                            updateBlitzSelectedList()
                        end
                    end
                    task.wait(0.2)
                end
            end)
        end
    end
})

LoopTab:AddButton({
    Name = "Bring Once",
    Callback = function()
        for _, playerName in ipairs(blitzSelectedPlayers) do
            local targetPlayer = Players:FindFirstChild(playerName)
            if targetPlayer and IsValidTarget(targetPlayer) then
                BringPlayer(targetPlayer)
                task.wait(0.5)
            end
        end
    end
})

LoopTab:AddToggle({
    Name = "Kick Selected Players",
    Default = false,
    Color = Color3.fromRGB(255, 255, 0),
    Callback = function(v)
        Config.Blitz.IsKicking = v
        
        if v then
            task.spawn(function()
                while Config.Blitz.IsKicking do
                    for i = #blitzSelectedPlayers, 1, -1 do
                        if not Config.Blitz.IsKicking then break end
                        
                        local playerName = blitzSelectedPlayers[i]
                        local targetPlayer = Players:FindFirstChild(playerName)
                        
                        if targetPlayer then
                            if IsValidKickTarget(targetPlayer) then
                                KickPlayer(targetPlayer)
                            end
                        else
                            table.remove(blitzSelectedPlayers, i)
                            updateBlitzSelectedList()
                        end
                    end
                    task.wait(0.2)
                end
            end)
        end
    end
})

