-- 🟣 Blobman タブ UI
-- ──────────────────────────────────────────────

-- ================= Loop Tab =================

local loopSelectedPlayers = {}
local isKilling = false
local isBringing = false
local isKicking = false
local loopNoclipConnection = nil
local loopNoclipping = false

local GrabEventsFolder = game:GetService("ReplicatedStorage"):WaitForChild("GrabEvents")
local DestroyGrabLine = GrabEventsFolder:WaitForChild("DestroyGrabLine")
local SetNetworkOwnerLoop = GrabEventsFolder:WaitForChild("SetNetworkOwner")

local function lookAt(from, to)
    local direction = (to - from).Unit
    local right = direction:Cross(Vector3.new(0, 1, 0))
    local up = right:Cross(direction)
    return CFrame.fromMatrix(from, right, up)
end

local function EnableLoopNoclip()
    if not loopNoclipConnection then
        loopNoclipping = false
        loopNoclipConnection = game:GetService("RunService").Stepped:Connect(function()
            if loopNoclipping == false and LocalPlayer.Character then
                for _, part in pairs(LocalPlayer.Character:GetChildren()) do
                    if part:IsA("BasePart") and part.CanCollide and part.Name ~= "floatName" then
                        part.CanCollide = false
                    end
                end
            end
            task.wait(0.21)
        end)
    end
end

local function DisableLoopNoclip()
    if loopNoclipConnection then
        loopNoclipConnection:Disconnect()
        loopNoclipConnection = nil
    end
    loopNoclipping = true
end

local function SNOWship(part)
    if part and typeof(part) == "Instance" then
        local distance = LocalPlayer:DistanceFromCharacter(part.Position)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and distance <= 30 then
            SetNetworkOwnerLoop:FireServer(part, lookAt(LocalPlayer.Character.HumanoidRootPart.Position, part.Position))
        end
    end
end

local function TeleportPlayerLoop(cf)
    local character = LocalPlayer.Character
    if character and typeof(cf) == "CFrame" then
        local root = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if root and humanoid then
            root.CFrame = root.CFrame.Rotation + cf.Position
            if humanoid.SeatPart == nil or tostring(humanoid.SeatPart.Parent) ~= "CreatureBlobman" then
                humanoid.Sit = false
            end
        end
    end
end

local function CreateSkyVelocity(part)
    if not part:FindFirstChild("SkyVelocity") then
        local bv = Instance.new("BodyVelocity", part)
        bv.Name = "SkyVelocity"
        bv.Velocity = Vector3.new(0, 100000000000000, 0)
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    end
end

local function CheckNetworkOwnership(player)
    if typeof(player) == "Instance" and player:IsA("Player") and player.Character then
        local head = player.Character:FindFirstChild("Head")
        if head and head:FindFirstChild("PartOwner") and head.PartOwner.Value == LocalPlayer.Name then
            return true
        end
    end
    return false
end

local function IsValidTarget(player)
    if typeof(player) == "Instance" and player ~= LocalPlayer then
        if player:IsA("Player") and player.Character then
            if player.Character:IsDescendantOf(workspace) then
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                if root and humanoid and humanoid.Health > 0 then
                    if player:FindFirstChild("InPlot") and player.InPlot.Value then return false end
                    if humanoid.FloorMaterial == Enum.Material.Air then return false end
                    return true
                end
            end
        end
    end
    return false
end

local function IsValidKickTarget(player)
    return IsValidTarget(player)
end

local function KillPlayer(targetPlayer)
    if not IsValidTarget(targetPlayer) then return end
    local root = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end
    local initialPos = LocalPlayer.Character.HumanoidRootPart.CFrame
    EnableLoopNoclip()
    for i = 1, 50 do
        SNOWship(root)
        if CheckNetworkOwnership(targetPlayer) or root.AssemblyLinearVelocity.Magnitude > 500 then
            CreateSkyVelocity(root)
            pcall(function() DestroyGrabLine:FireServer(root) end)
            break
        end
        task.wait()
        if root.Position.Y <= -12 then
            TeleportPlayerLoop(CFrame.new(root.Position + Vector3.new(0, 5, -15)))
        else
            TeleportPlayerLoop(CFrame.new(root.Position + Vector3.new(0, -10, -10)))
        end
        humanoid.BreakJointsOnDeath = false
        humanoid:ChangeState(Enum.HumanoidStateType.Dead)
        humanoid.Jump = true
        humanoid.Sit = false
    end
    DisableLoopNoclip()
    TeleportPlayerLoop(initialPos)
end

local function BringPlayer(targetPlayer)
    if not IsValidTarget(targetPlayer) then return end
    local root = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end
    local initialPos = LocalPlayer.Character.HumanoidRootPart.CFrame
    local myPos = LocalPlayer.Character.HumanoidRootPart.Position
    EnableLoopNoclip()
    for i = 1, 50 do
        SNOWship(root)
        if CheckNetworkOwnership(targetPlayer) then
            root.CFrame = CFrame.new(myPos + Vector3.new(0, 3, 0))
            pcall(function() DestroyGrabLine:FireServer(root) end)
            break
        end
        task.wait()
        if root.Position.Y <= -12 then
            TeleportPlayerLoop(CFrame.new(root.Position + Vector3.new(0, 5, -15)))
        else
            TeleportPlayerLoop(CFrame.new(root.Position + Vector3.new(0, -10, -10)))
        end
        humanoid.Jump = true
        humanoid.Sit = false
    end
    DisableLoopNoclip()
    TeleportPlayerLoop(initialPos)
end

local function KickPlayerLoop(targetPlayer)
    if not IsValidKickTarget(targetPlayer) then return end
    local root = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local initialPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.CFrame
    for i = 0, 50 do
        EnableLoopNoclip()
        SNOWship(root)
        if not IsValidKickTarget(targetPlayer) or not isKicking then
            CreateSkyVelocity(root)
            pcall(function() DestroyGrabLine:FireServer(root) end)
            break
        end
        if CheckNetworkOwnership(targetPlayer) or root.AssemblyLinearVelocity.Magnitude > 500 then
            CreateSkyVelocity(root)
            pcall(function() DestroyGrabLine:FireServer(root) end)
            break
        end
        task.wait()
        if root.Position.Y <= -12 then
            TeleportPlayerLoop(CFrame.new(root.Position + Vector3.new(0, 5, -15)))
        else
            TeleportPlayerLoop(CFrame.new(root.Position + Vector3.new(0, -10, -10)))
        end
    end
    DisableLoopNoclip()
    if initialPos then TeleportPlayerLoop(initialPos) end
end

local function UpdateLoopPlayerList()
    local options = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local alreadySelected = false
            for _, selected in ipairs(loopSelectedPlayers) do
                if selected == player.Name then alreadySelected = true break end
            end
            if not alreadySelected then
                table.insert(options, player.Name .. " (" .. player.DisplayName .. ")")
            end
        end
    end
    table.sort(options)
    return options
end

local LoopTab = Window:MakeTab({
    Name = "Loop",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

local LoopSection1 = LoopTab:AddSection({ Name = "Player Selection" })
local LoopSection2 = LoopTab:AddSection({ Name = "Kill Controls" })
local LoopSection3 = LoopTab:AddSection({ Name = "Bring Controls" })
local LoopSection4 = LoopTab:AddSection({ Name = "Kick Controls" })

local LoopSelectedLabel = LoopSection1:AddLabel("Selected: None")

local function UpdateLoopSelectedList()
    if #loopSelectedPlayers == 0 then
        LoopSelectedLabel:Set("Selected: None")
    else
        LoopSelectedLabel:Set("Selected: " .. table.concat(loopSelectedPlayers, ", "))
    end
end

local LoopPlayerDropdown = LoopSection1:AddDropdown({
    Name = "Select Player",
    Default = "",
    Options = UpdateLoopPlayerList(),
    Callback = function(value)
        local playerName = string.split(value, " ")[1]
        local player = Players:FindFirstChild(playerName)
        if player and player ~= LocalPlayer then
            local found = false
            for _, p in ipairs(loopSelectedPlayers) do
                if p == playerName then found = true break end
            end
            if not found then
                table.insert(loopSelectedPlayers, playerName)
                UpdateLoopSelectedList()
            end
        end
    end
})

LoopSection1:AddButton({
    Name = "Reset Selection",
    Callback = function()
        loopSelectedPlayers = {}
        UpdateLoopSelectedList()
    end
})

LoopSection2:AddToggle({
    Name = "Kill Selected Players",
    Default = false,
    Callback = function(value)
        isKilling = value
        if value then
            task.spawn(function()
                while isKilling do
                    for i = #loopSelectedPlayers, 1, -1 do
                        if not isKilling then break end
                        local playerName = loopSelectedPlayers[i]
                        local targetPlayer = Players:FindFirstChild(playerName)
                        if targetPlayer then
                            if IsValidTarget(targetPlayer) then KillPlayer(targetPlayer) end
                        else
                            table.remove(loopSelectedPlayers, i)
                            UpdateLoopSelectedList()
                        end
                    end
                    task.wait(0.2)
                end
            end)
        end
    end
})

LoopSection2:AddButton({
    Name = "Kill Once",
    Callback = function()
        for _, playerName in ipairs(loopSelectedPlayers) do
            local targetPlayer = Players:FindFirstChild(playerName)
            if targetPlayer and IsValidTarget(targetPlayer) then
                KillPlayer(targetPlayer)
                task.wait(0.5)
            end
        end
    end
})

LoopSection3:AddToggle({
    Name = "Bring Selected Players",
    Default = false,
    Callback = function(value)
        isBringing = value
        if value then
            task.spawn(function()
                while isBringing do
                    for i = #loopSelectedPlayers, 1, -1 do
                        if not isBringing then break end
                        local playerName = loopSelectedPlayers[i]
                        local targetPlayer = Players:FindFirstChild(playerName)
                        if targetPlayer then
                            if IsValidTarget(targetPlayer) then BringPlayer(targetPlayer) end
                        else
                            table.remove(loopSelectedPlayers, i)
                            UpdateLoopSelectedList()
                        end
                    end
                    task.wait(0.2)
                end
            end)
        end
    end
})

LoopSection3:AddButton({
    Name = "Bring Once",
    Callback = function()
        for _, playerName in ipairs(loopSelectedPlayers) do
            local targetPlayer = Players:FindFirstChild(playerName)
            if targetPlayer and IsValidTarget(targetPlayer) then
                BringPlayer(targetPlayer)
                task.wait(0.5)
            end
        end
    end
})

LoopSection4:AddToggle({
    Name = "Kick Selected Players",
    Default = false,
    Callback = function(value)
        isKicking = value
        if value then
            task.spawn(function()
                while isKicking do
                    for i = #loopSelectedPlayers, 1, -1 do
                        if not isKicking then break end
                        local playerName = loopSelectedPlayers[i]
                        local targetPlayer = Players:FindFirstChild(playerName)
                        if targetPlayer then
                            if IsValidKickTarget(targetPlayer) then KickPlayerLoop(targetPlayer) end
                        else
                            table.remove(loopSelectedPlayers, i)
                            UpdateLoopSelectedList()
                        end
                    end
                    task.wait(0.2)
                end
            end)
        end
    end
})

Players.PlayerAdded:Connect(function()
    task.wait(0.5)
    LoopPlayerDropdown:Refresh(UpdateLoopPlayerList(), true)
end)

Players.PlayerRemoving:Connect(function()
    task.wait(0.5)
    LoopPlayerDropdown:Refresh(UpdateLoopPlayerList(), true)
end)

