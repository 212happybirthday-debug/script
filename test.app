-- ──────────────────────────────────────────────
-- Kick Aura v1 (Ultra FTAP ロジック移植)
-- Heartbeat毎に半径30内のプレイヤーにblobKickFast
-- NetworkOwner奪取 + BodyVelocityでY=2に引き寄せ
-- ──────────────────────────────────────────────

-- BlobmanBeta: Ultra FTAP用関数群
local BlobmanBeta = {}
function BlobmanBeta.getLocalRoot() return getRoot() end
function BlobmanBeta.getLocalHum()  return getHum() end
function BlobmanBeta.getInv()
    return Services.Workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
end
function BlobmanBeta.SetNetworkOwner(part)
    pcall(function()
        SetNetworkOwner:FireServer(part, getRoot().CFrame)
    end)
end
function BlobmanBeta.ungrab(part)
    pcall(function() DestroyLine:FireServer(part) end)
end
function BlobmanBeta.getBlobman()
    local inv = BlobmanBeta.getInv()
    if inv then
        local v = inv:FindFirstChild("CreatureBlobman")
        if v and v:FindFirstChild("VehicleSeat") then return v end
    end
    for _, p in Services.Workspace.PlotItems:GetChildren() do
        local m = p:FindFirstChild("CreatureBlobman")
        if m and m:FindFirstChild("PlayerValue")
        and m.PlayerValue.Value == LP.Name then return m end
    end
    return nil
end
function BlobmanBeta.spawnBlobman()
    pcall(function()
        RS.MenuToys.SpawnToyRemoteFunction:InvokeServer(
            "CreatureBlobman", getRoot().CFrame, Vector3.zero)
    end)
    task.wait(0.5)
    return BlobmanBeta.getBlobman()
end
function BlobmanBeta.destroyBlobman()
    local blob = BlobmanBeta.getBlobman()
    if blob then pcall(function() DestroyToy:FireServer(blob) end) end
end
function BlobmanBeta.isSittingOnBlobman()
    local hum  = getHum()
    local blob = BlobmanBeta.getBlobman()
    if not hum or not blob or not blob:FindFirstChild("VehicleSeat") then return false end
    return hum.Sit and hum.SeatPart == blob.VehicleSeat
end
function BlobmanBeta.ensureSitBlobman()
    local blob = BlobmanBeta.getBlobman()
    if not blob or not blob:FindFirstChild("VehicleSeat") then return false end
    local hum = getHum()
    if hum and not hum.Sit then
        blob.VehicleSeat:Sit(hum)
        task.wait(0.3)
    end
    return BlobmanBeta.isSittingOnBlobman()
end
function BlobmanBeta.blobGrabFast(blob, target, side)
    if not blob then return false end
    local detector = blob:FindFirstChild(side .. "Detector")
    if not detector then return false end
    local weld = detector:FindFirstChild(side .. "Weld")
    if not weld then return false end
    local script = blob:FindFirstChild("BlobmanSeatAndOwnerScript", true)
    if not script then return false end
    local remote = script:FindFirstChild("CreatureGrab")
    if remote then pcall(function() remote:FireServer(detector, target, weld) end); return true end
    return false
end
function BlobmanBeta.blobDropFast(blob, target, side)
    if not blob then return end
    local detector = blob:FindFirstChild(side .. "Detector")
    if not detector then return end
    local script = blob:FindFirstChild("BlobmanSeatAndOwnerScript", true)
    if not script then return end
    local remote = script:FindFirstChild("CreatureDrop")
    if remote then pcall(function() remote:FireServer(detector, target) end) end
end
function BlobmanBeta.blobKickFast(blob, targetRoot, side)
    BlobmanBeta.blobGrabFast(blob, getRoot(), side)
    task.wait()
    BlobmanBeta.SetNetworkOwner(targetRoot)
    task.wait()
    targetRoot.CFrame = targetRoot.CFrame + Vector3.new(0, 16, 0)
    task.wait()
    BlobmanBeta.ungrab(targetRoot)
    task.wait()
    BlobmanBeta.blobGrabFast(blob, targetRoot, side)
    task.wait()
    BlobmanBeta.blobDropFast(blob, targetRoot, side)
    task.wait()
    BlobmanBeta.ungrab(targetRoot)
end

-- BodyVelocity管理
local bv1_bodyVelocities = {}
local function bv1_addBodyVelocity(player, targetPos)
    local char = player.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    local existing = rootPart:FindFirstChild("FTAP_Velocity")
    if existing then existing:Destroy() end
    local bv = Instance.new("BodyVelocity")
    bv.Name = "FTAP_Velocity"
    bv.MaxForce = Vector3.new(100000, 100000, 100000)
    bv.Velocity = (targetPos - rootPart.Position).Unit * 150
    bv.Parent = rootPart
    bv1_bodyVelocities[player] = bv
    task.delay(3, function()
        if bv and bv.Parent then bv:Destroy(); bv1_bodyVelocities[player] = nil end
    end)
end
local function bv1_pullPlayers()
    local myRoot = getRoot()
    if not myRoot then return end
    local targetPos = Vector3.new(myRoot.Position.X, 2, myRoot.Position.Z)
    for _, player in pairs(Services.Players:GetPlayers()) do
        if player ~= LP then
            local char = player.Character
            local rootPart = char and char:FindFirstChild("HumanoidRootPart")
            if rootPart and (rootPart.Position - targetPos).Magnitude <= 50 then
                bv1_addBodyVelocity(player, targetPos)
            end
        end
    end
end
local function bv1_clearAll()
    for _, bv in pairs(bv1_bodyVelocities) do
        pcall(function() if bv and bv.Parent then bv:Destroy() end end)
    end
    bv1_bodyVelocities = {}
end

-- NetworkOwner奪取
local function bv1_stealNetworkOwnership()
    local myRoot = getRoot()
    if not myRoot then return end
    for _, player in pairs(Services.Players:GetPlayers()) do
        if player ~= LP then
            local char = player.Character
            local targetRoot = char and char:FindFirstChild("HumanoidRootPart")
            if targetRoot and (myRoot.Position - targetRoot.Position).Magnitude <= 30 then
                pcall(function() BlobmanBeta.SetNetworkOwner(targetRoot) end)
            end
        end
    end
end

-- FTAP実行
local function bv1_executeFtap()
    local myRoot = getRoot()
    if not myRoot then return end
    local blob = BlobmanBeta.getBlobman()
    if not blob then return end
    for _, player in pairs(Services.Players:GetPlayers()) do
        if player ~= LP then
            local char = player.Character
            local targetRoot = char and char:FindFirstChild("HumanoidRootPart")
            if targetRoot and (myRoot.Position - targetRoot.Position).Magnitude <= 30 then
                pcall(function() BlobmanBeta.blobKickFast(blob, targetRoot, "Left") end)
            end
        end
    end
end

-- ループ管理
local kickAuraV1_active = false
local kickAuraV1_ftapConn = nil
local kickAuraV1_velConn  = nil

local function kickAuraV1_start()
    local blob = BlobmanBeta.getBlobman()
    if not blob then blob = BlobmanBeta.spawnBlobman() end
    if not blob then
        OrionLib:MakeNotification({Name="❌ ERROR", Content="Failed to spawn Blobman", Time=4})
        return false
    end
    if not BlobmanBeta.isSittingOnBlobman() then
        BlobmanBeta.ensureSitBlobman()
        if not BlobmanBeta.isSittingOnBlobman() then
            OrionLib:MakeNotification({Name="❌ ERROR", Content="Failed to sit on Blobman", Time=4})
            return false
        end
    end
    kickAuraV1_active = true
    kickAuraV1_ftapConn = Services.RunService.Heartbeat:Connect(function()
        if not kickAuraV1_active then return end
        bv1_executeFtap()
        bv1_stealNetworkOwnership()
    end)
    kickAuraV1_velConn = Services.RunService.Heartbeat:Connect(function()
        if not kickAuraV1_active then return end
        bv1_pullPlayers()
    end)
    OrionLib:MakeNotification({Name="▶ Kick Aura v1 ON", Content="FTAP ~60/sec | NetworkSteal | Pull Y=2", Time=3})
    return true
end

local function kickAuraV1_stop()
    kickAuraV1_active = false
    if kickAuraV1_ftapConn then kickAuraV1_ftapConn:Disconnect(); kickAuraV1_ftapConn = nil end
    if kickAuraV1_velConn  then kickAuraV1_velConn:Disconnect();  kickAuraV1_velConn  = nil end
    bv1_clearAll()
    BlobmanBeta.destroyBlobman()
    OrionLib:MakeNotification({Name="⏹ Kick Aura v1 OFF", Content="FTAP停止", Time=2})
end


-- ══════════════════════════════════════════════
-- 🟣 Blobman タブ (Suisei Hub ロジック完全移植)
-- ══════════════════════════════════════════════

-- ──────────────────────────────────────────────
-- Blobman ユーティリティ関数 (Suisei Hub移植)
-- ──────────────────────────────────────────────
local function blobMoveTo(part, x)
    for _, v in ipairs(part.Parent:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end
    local pos = typeof(x) == "CFrame" and x.Position or x
    local b = Instance.new("BodyPosition")
    b.MaxForce = Vector3.one * math.huge
    b.Position = pos
    b.P = 2e4
    b.D = 5e3
    b.Parent = part
    task.spawn(function()
        b.ReachedTarget:Wait()
        pcall(game.Destroy, b)
        for _, v in ipairs(part.Parent:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = true end
        end
    end)
end

local function getBlobman()
    local inv = Services.Workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
    local v = inv and inv:FindFirstChild("CreatureBlobman")
    if v then
        if v.ClassName ~= "Model" then return false end
        if not v:FindFirstChild("VehicleSeat") then return false end
        return v
    end
    local result = nil
    pcall(function()
        for _, p in ipairs(Services.Workspace.PlotItems:GetChildren()) do
            local m = p:FindFirstChild("CreatureBlobman")
            if m and m:FindFirstChild("PlayerValue") and m.PlayerValue.Value == LP.Name then
                if m.ClassName == "Model" and m:FindFirstChild("VehicleSeat") then
                    result = m
                end
            end
        end
    end)
    return result
end

local function spawnBlobman()
    local r = getRoot()
    if r then
        pcall(function()
            Services.ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(
                "CreatureBlobman", r.CFrame, Vector3.zero)
        end)
    end
    task.wait(0.3)
    return getBlobman()
end

local function blobGrab(blob, target, side)
    pcall(function()
        local det  = blob:FindFirstChild(side .. "Detector")
        local weld = det and det:FindFirstChild(side .. "Weld")
        blob.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(det, target, weld)
    end)
end

local function blobDrop(blob, target, side)
    pcall(function()
        local det = blob:FindFirstChild(side .. "Detector")
        blob.BlobmanSeatAndOwnerScript.CreatureDrop:FireServer(det, target)
    end)
end

local function blobBring(blob, target, side)
    local r = getRoot()
    if not r then return end
    local pos = r.CFrame
    r.CFrame = target.CFrame
    task.wait(0.25)
    blobGrab(blob, target, side)
    task.wait(0.25)
    r.CFrame = pos
end

local function blobKick(blob, target, side)
    local r = getRoot()
    if not r then return end
    blobGrab(blob, r, side)
    task.wait(0.1)
    SetNetworkOwner:FireServer(target, r.CFrame)
    task.wait()
    target.CFrame = target.CFrame + Vector3.new(0, 16, 0)
    task.wait(0.1)
    pcall(function() DestroyLine:FireServer(target) end)
    blobGrab(blob, target, side)
end

local function blobIsFriend(p)
    if not p or not p.UserId then return false end
    return pcall(function() return LP:IsFriendsWith(p.UserId) end)
        and LP:IsFriendsWith(p.UserId)
end

local function blobIsInPlot(p)
    local v = p:FindFirstChild("InPlot")
    return v and v.Value
end

local function getPlayerFromName(name)
    local tplayer = nil
    local sname = name:lower()
    for _, player in pairs(Services.Players:GetPlayers()) do
        if player.DisplayName:lower():sub(1, #sname) == sname then
            tplayer = player; break
        elseif player.Name:lower():sub(1, #sname) == sname then
            if not tplayer then tplayer = player end
        end
    end
    return tplayer
end

-- config テーブル
local blobCfg = {
    Target        = "",
    ArmSide       = "Left",
    Noclip        = false,
    GrabAura      = false,
    KickAura      = false,
    LoopKick      = false,
    LoopKickAll   = false,
    IgnoreFriend  = false,
    IgnoreIsInPlot = false,
    AuraRadius    = 28,
}

-- ──────────────────────────────────────────────
-- Blobman メインループ (Suisei Hub移植)
-- ──────────────────────────────────────────────
local blobLoopKickTimer = 0
local blobMainConn = nil

local function startBlobMainLoop()
    if blobMainConn then return end
    blobMainConn = Services.RunService.Heartbeat:Connect(function(dt)
        blobLoopKickTimer = blobLoopKickTimer + dt

        -- Noclip
        if blobCfg.Noclip then
            local blob = getBlobman()
            if blob then
                for _, v in ipairs(blob:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end
        end

        -- Aura
        local r = getRoot()
        if r and getChar() then
            for _, v in ipairs(Services.Workspace:GetPartBoundsInRadius(r.Position, blobCfg.AuraRadius)) do
                if not v.Anchored and not v:IsDescendantOf(getChar()) then
                    local p = Services.Players:GetPlayerFromCharacter(v.Parent)
                    if blobIsFriend(p) and blobCfg.IgnoreFriend then continue end

                    -- Grab Aura
                    if blobCfg.GrabAura then
                        if v.Name ~= "HumanoidRootPart" or not getBlobman() then continue end
                        if p and blobCfg.IgnoreFriend and blobIsFriend(p) then continue end
                        if p and p == LP then continue end
                        local blob = getBlobman()
                        local side = (math.random() >= 0.5) and "Left" or "Right"
                        blobGrab(blob, v, side)
                    end

                    -- Kick Aura
                    if blobCfg.KickAura then
                        if not p then continue end
                        local hum = getHum()
                        if hum and hum.Sit then
                            if v.Name ~= "HumanoidRootPart" or not getBlobman() then continue end
                            local blob = getBlobman()
                            local side = (math.random() >= 0.5) and "Left" or "Right"
                            task.spawn(function() blobKick(blob, v, side) end)
                        end
                    end
                end
            end
        end

        -- LoopKick / LoopKickAll (1.5秒ごと)
        if blobLoopKickTimer >= 1.5 then
            if blobCfg.LoopKick then
                local target = getPlayerFromName(blobCfg.Target)
                local blob = getBlobman() or spawnBlobman()
                if target and blob then
                    local char = target.Character
                    if char then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            local side = (math.random() >= 0.5) and "Left" or "Right"
                            local pos = getRoot() and getRoot().CFrame
                            task.wait(0.5)
                            if getRoot() then getRoot().CFrame = root.CFrame end
                            task.wait()
                            blobKick(blob, root, side)
                            task.wait(0.5)
                            if getRoot() then getRoot().CFrame = pos end
                        end
                    end
                end
            end

            if blobCfg.LoopKickAll then
                local blob = getBlobman() or spawnBlobman()
                if blob then
                    for _, p in ipairs(Services.Players:GetPlayers()) do
                        if p == LP then continue end
                        if not blobCfg.IgnoreIsInPlot and blobIsInPlot(p) then continue end
                        if blobCfg.IgnoreFriend and blobIsFriend(p) then continue end
                        if not p.Character then continue end
                        local root = p.Character:FindFirstChild("HumanoidRootPart")
                        if not root then continue end
                        local side = (math.random() >= 0.5) and "Left" or "Right"
                        local pos = getRoot() and getRoot().CFrame
                        task.wait(0.25)
                        if getRoot() then getRoot().CFrame = root.CFrame end
                        task.wait()
                        blobKick(blob, root, side)
                        task.wait(0.25)
                        if getRoot() then getRoot().CFrame = pos end
                    end
                end
            end

            blobLoopKickTimer = 0
        end
    end)
end

local function updateBlobLoop()
    if blobCfg.Noclip or blobCfg.GrabAura or blobCfg.KickAura
    or blobCfg.LoopKick or blobCfg.LoopKickAll then
        startBlobMainLoop()
    else
        if blobMainConn then blobMainConn:Disconnect(); blobMainConn = nil end
    end
end

