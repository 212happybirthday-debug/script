AntiTab:AddToggle({Name = "アンチペイント", Default = false, Callback = function(v)
    config.Anti.Paint = v
    local function setTouchQuery(s)
        local char = LP.Character
        if char then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanTouch = s
                    part.CanQuery = s
                end
            end
        end
    end
    if v then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name == "PaintPlayerPart" then
                local clone = obj:Clone()
                clone.Archivable = true
                antiState.paintPartsBackup[obj:GetDebugId()] = { clone = clone, parent = obj.Parent }
                obj:Destroy()
            end
        end
        local conn = workspace.DescendantAdded:Connect(function(obj)
            if obj:IsA("BasePart") and obj.Name == "PaintPlayerPart" then
                task.defer(function()
                    if obj and obj.Parent then
                        local clone = obj:Clone()
                        clone.Archivable = true
                        antiState.paintPartsBackup[obj:GetDebugId()] = { clone = clone, parent = obj.Parent }
                        obj:Destroy()
                    end
                end)
            end
        end)
        table.insert(antiState.paintConnections, conn)
        setTouchQuery(false)
    else
        for _, conn in ipairs(antiState.paintConnections) do
            if conn.Connected then conn:Disconnect() end
        end
        antiState.paintConnections = {}
        for id, data in pairs(antiState.paintPartsBackup) do
            if data.clone and data.parent then
                data.clone.Parent = data.parent
            end
        end
        antiState.paintPartsBackup = {}
        setTouchQuery(true)
    end
end})
