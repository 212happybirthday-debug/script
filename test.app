			end)

			UserInputService.InputBegan:Connect(function(input, processed)
				if (input.KeyCode == Enum.KeyCode.K and not processed) then
					if Debounce then return end
					if Hidden then
						Hidden = false
						Unhide()
					else
						Hidden = true
						Hide()
					end
				end
			end)

