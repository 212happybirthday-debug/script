local AuraTimer = 0
local SnipeTimer = 0

RunService.Heartbeat:Connect(function(dt)
    local root = HRP()
    if not root then return end

    AuraTimer = AuraTimer + dt
    SnipeTimer = SnipeTimer + dt

    if config.Anti.Burn and extPart then
        if root:FindFirstChild("FireLight") or root:FindFirstChild("FireParticleEmitter") then
            extPart.CFrame = root.CFrame
        else
            extPart.CFrame = CFrame.new(originalPos)
        end
    end

    if config.Anti.Ragdoll then
        local hum = getHum()
        if hum and (hum:GetState() == Enum.HumanoidStateType.Ragdoll or hum:GetState() == Enum.HumanoidStateType.FallingDown) then
            if RagdollRemote then RagdollRemote:FireServer(root, 0) end
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end

    if config.Anti.BananaSnowball then
        local char = LP.Character
        local hum = getHum()
        if hum and root and hum.Health > 0 then
            hum.Sit = true
            hum:ChangeState(Enum.HumanoidStateType.Running)
            local vec = W.CurrentCamera.CFrame.LookVector
            root.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(vec.X, 0, vec.Z))
            task.wait()
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end

    if AuraTimer >= 0.5 then
        AuraTimer = 0
        local parts = W:GetPartBoundsInRadius(root.Position, config.Auras.Radius)
        for _, v in ipairs(parts) do
            if not v.Anchored and not v:IsDescendantOf(LP.Character) and
               (v.Name == "HumanoidRootPart" or v.Name == "Torso" or v.Name == "Head") then
                local p = Players:GetPlayerFromCharacter(v.Parent)
                if config.Settings.OnlyPlayer and not p then continue end
                if config.Auras.VoidAura then
                    task.spawn(function()
                        SetNetworkOwner(v)
                        v.CanCollide = false
                        Velocity(v, Vector3.new(0, 1e4, 0))
                    end)
                end
                if config.Auras.KillAura then
                    task.spawn(function()
                        SetNetworkOwner(v)
                        v.CanCollide = false
                        MoveTo(v, CFrame.new(4096, -75, 4096))
                        Velocity(v, Vector3.new(0, -1e3, 0))
                    end)
                end
                if config.Auras.PoisonAura then
                    task.spawn(function()
                        SetNetworkOwner(v)
                        MoveTo(v, CFrame.new(58, -70, 271))
                    end)
                end
                if config.Auras.RagdollAura then
                    task.spawn(function()
                        local pos = v.CFrame
                        SetNetworkOwner(v)
                        Velocity(v, Vector3.new(0, -256, 0))
                        task.wait()
                        MoveTo(v, pos)
                        Velocity(v, Vector3.zero)
                    end)
                end
                if config.Auras.DeathAura then
                    task.spawn(function()
                        SetNetworkOwner(v)
                        task.wait(0.1)
                        v.Parent:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Dead)
                        task.wait(0.5)
                        ungrab(v)
                    end)
                end
                if config.Auras.FireAura then
                    task.spawn(function()
                        local e = spawntoy("Campfire", root.CFrame).SoundPart
                        SetNetworkOwner(e)
                        task.wait(0.1)
                        e.CFrame = v.CFrame
                        task.delay(0.5, destroyToy, e.Parent)
                    end)
                end
                if config.Auras.AnchorAura then
                    task.spawn(function() anchor(v) end)
                end
                if config.Auras.NoclipAura then
                    task.spawn(function()
                        SetNetworkOwner(v)
                        task.wait(0.1)
                        v.CanCollide = false
                    end)
                end
            end
        end
    end

    if SnipeTimer >= 1 then
        SnipeTimer = 0
        if config.Snipe.Target and config.Snipe.Target.Character then
            local troot = config.Snipe.Target.Character:FindFirstChild("HumanoidRootPart")
            if troot then
                if config.Snipe.LoopVoid then
                    task.spawn(function()
                        Snipefunc(troot, function()
                            Velocity(troot, Vector3.new(0, 1e4, 0))
                        end)
                    end)
                end
                if config.Snipe.LoopKill then
                    task.spawn(function()
                        Snipefunc(troot, function()
                            MoveTo(troot, CFrame.new(512, -85, 512))
                            Velocity(troot, Vector3.new(0, -1e3, 0))
                        end)
                    end)
                end
                if config.Snipe.LoopPoison then
                    task.spawn(function()
                        Snipefunc(troot, function()
                            MoveTo(troot, CFrame.new(58, -70, 271))
                        end)
                    end)
                end
                if config.Snipe.LoopRagdoll then
                    task.spawn(function()
                        Snipefunc(troot, function()
                            local rpos = troot.CFrame
                            Velocity(troot, Vector3.new(0, -64, 0))
                            task.wait(0.1)
                            MoveTo(troot, rpos)
                            Velocity(troot, Vector3.zero)
                        end)
                    end)
                end
                if config.Snipe.LoopDeath then
                    task.spawn(function()
                        Snipefunc(troot, function()
                            troot.Parent:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Dead)
                            task.wait(0.5)
                            ungrab(troot)
                        end)
                    end)
                end
                if config.Snipe.LoopBring then
                    task.spawn(function()
                        local pos = HRP().CFrame
                        Snipefunc(troot, function()
                            task.wait(0.01)
                            troot.CFrame = pos
                            task.wait(0.5)
                            ungrab(troot)
                            HRP().CFrame = pos
                        end)
                    end)
                end
            end
        end
    end

    if config.Player.SpeedEnabled then
        local hum = getHum()
        if hum then
            local moveDir = hum.MoveDirection
            if moveDir.Magnitude > 0 then
                root.CFrame = root.CFrame + moveDir * (config.Player.SpeedValue / 60)
            end
        end
    end
    if config.Player.JumpEnabled then
        local hum = getHum()
        if hum then hum.JumpPower = config.Player.JumpValue end
    end
    if config.Player.Noclip and LP.Character then
        for _, v in pairs(LP.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
        if LP.Character:FindFirstChildOfClass("Humanoid") then
            local seat = LP.Character:FindFirstChildOfClass("Humanoid").SeatPart
            if seat then
                for _, v in pairs(seat.Parent:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end
        end
    end
    if config.CrazyLine.Enabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local r = p.Character:FindFirstChild("HumanoidRootPart")
                if r and RS.GrabEvents.CreateGrabLine then
                    RS.GrabEvents.CreateGrabLine:FireServer(r, CFrame.identity)
                end
            end
        end
    end
    if config.Blobman.Noclip then
        local blob = getBlobman()
        if blob then
            for _, v in ipairs(blob:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end
end)

W.ChildAdded:Connect(function(v)
    if v.Name == "GrabParts" and v:IsA("Model") then
        local Owner = v:FindFirstChild("Owner")
        local GrabPart = v:FindFirstChild("GrabPart")
        if not GrabPart then return end
        local weld = GrabPart:FindFirstChild("WeldConstraint")
        if not weld then return end
        local Grabbing = weld.Part1
        if Grabbing.Anchored then return end

        if config.Grabs.VoidGrab then
            task.spawn(function()
                for _ = 1, 3 do task.wait() SetNetworkOwner(Grabbing) end
                task.wait()
                Velocity(Grabbing, Vector3.new(0, 1e4, 0))
            end)
        end
        if config.Grabs.KillGrab then
            task.spawn(function()
                for _ = 1, 3 do task.wait() SetNetworkOwner(Grabbing) end
                task.wait()
                MoveTo(Grabbing, CFrame.new(4096, -75, 4096))
                Velocity(Grabbing, Vector3.new(0, -1e3, 0))
            end)
        end
        if config.Grabs.PoisonGrab then
            task.spawn(function()
                for _ = 1, 3 do task.wait() SetNetworkOwner(Grabbing) end
                task.wait()
                MoveTo(Grabbing, CFrame.new(58, -70, 271))
            end)
        end
        if config.Grabs.RagdollGrab then
            task.spawn(function()
                local pos = Grabbing.CFrame
                for _ = 1, 3 do task.wait() SetNetworkOwner(Grabbing) end
                task.wait()
                Velocity(Grabbing, Vector3.new(0, -256, 0))
                task.wait()
                MoveTo(Grabbing, pos)
                Velocity(Grabbing, Vector3.zero)
            end)
        end
        if config.Grabs.DeathGrab then
            task.spawn(function()
                for _ = 1, 3 do task.wait() SetNetworkOwner(Grabbing) end
                task.wait(0.1)
                Grabbing.Parent:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Dead)
                task.wait(0.5)
                ungrab(Grabbing)
            end)
        end
        if config.Grabs.AnchorGrab then
            task.spawn(function() anchor(Grabbing) end)
        end
        if config.Grabs.KickGrab then
            task.spawn(function()
                local p = Players:GetPlayerFromCharacter(Grabbing.Parent)
                if p then
                    local character = p.Character
                    if not character then return end
                    local troot = character:FindFirstChild("HumanoidRootPart")
                    if not troot then return end
                    local hum = character:FindFirstChildOfClass("Humanoid")
                    task.wait(0.5)
                    ungrab(Grabbing)
                    task.spawn(function()
                        while p and troot and troot.Parent do
                            if hum and hum.FloorMaterial ~= Enum.Material.Air then
                                local pos = HRP().CFrame
                                task.wait()
                                HRP().CFrame = troot.CFrame
                                task.wait(0.1)
                                SetNetworkOwner(troot)
                                task.wait(0.1)
                                MoveTo(Grabbing, CFrame.new(25e25, 25e25, 25e25))
                                Velocity(troot, troot.AssemblyLinearVelocity * 25e25)
                                task.wait()
                                ungrab(troot)
                                HRP().CFrame = pos
                            end
                            task.wait()
                        end
                    end)
                end
            end)
        end
        if config.Grabs.NoclipGrab then
            task.spawn(function()
                while Grabbing.Parent and v do
                    for _, p in ipairs(Grabbing.Parent:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                    task.wait()
                end
            end)
        end
        if config.Grabs.FlingEnabled then
            v:GetPropertyChangedSignal("Parent"):Connect(function()
                if not v.Parent then
                    local vel = Instance.new("BodyVelocity", Grabbing)
                    vel.MaxForce = Vector3.one * math.huge
                    vel.Velocity = W.CurrentCamera.CFrame.LookVector * config.Grabs.FlingPower
                    Debris:AddItem(vel, 0.1)
                end
            end)
        end
        if config.Grabs.SkyGrab then
            task.spawn(function()
                for _ = 1, 3 do task.wait() SetNetworkOwner(Grabbing) end
                local bv = Instance.new("BodyVelocity")
                bv.MaxForce = Vector3.new(0, math.huge, 0)
                bv.Velocity = Vector3.new(0, 100, 0)
                bv.Parent = Grabbing
                task.delay(1, function() pcall(function() bv:Destroy() end) end)
            end)
        end
        if config.Grabs.SpinGrab then
            task.spawn(function()
                local bav = Instance.new("BodyAngularVelocity")
                bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bav.AngularVelocity = Vector3.new(0, 1000, 0)
                bav.Parent = Grabbing
                task.delay(1, function() pcall(function() bav:Destroy() end) end)
            end)
        end
        if config.Grabs.UpGrab then
            task.spawn(function()
                for _ = 1, 3 do task.wait() SetNetworkOwner(Grabbing) end
                Grabbing.CFrame = Grabbing.CFrame + Vector3.new(0, 30, 0)
            end)
        end
        if config.Grabs.DownGrab then
            task.spawn(function()
                for _ = 1, 3 do task.wait() SetNetworkOwner(Grabbing) end
                Grabbing.CFrame = Grabbing.CFrame - Vector3.new(0, 30, 0)
            end)
        end
        if config.Grabs.ChaosGrab then
            task.spawn(function()
                local bp = Instance.new("BodyPosition")
                local bg = Instance.new("BodyGyro")
                bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bp.Parent = Grabbing
                bg.Parent = Grabbing
                local startTime = tick()
                while Grabbing and Grabbing.Parent and config.Grabs.ChaosGrab and tick() - startTime < 10 do
                    bp.Position = Grabbing.Position + Vector3.new(math.random(-50, 50), math.random(-50, 50), math.random(-50, 50))
                    bg.CFrame = CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)))
                    task.wait(0.1)
                end
                pcall(function() bp:Destroy() bg:Destroy() end)
            end)
        end
        if config.Grabs.HighSpeedGrab then
            task.spawn(function()
                local bv = Instance.new("BodyVelocity")
                bv.MaxForce = Vector3.new(0, math.huge, 0)
                bv.Velocity = Vector3.new(0, 350, 0)
                bv.Parent = Grabbing
                task.delay(1, function() pcall(function() bv:Destroy() end) end)
            end)
        end
        if config.Grabs.FreezeGrab then
            task.spawn(function()
                local bp = Instance.new("BodyPosition")
                bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bp.Position = Grabbing.Position
                bp.Parent = Grabbing
                task.delay(1, function() pcall(function() bp:Destroy() end) end)
            end)
        end
    end
end)

