local TargetSets = {
    ["ガラスボックス"] = {"GlassBoxGray"},
    ["プープ"] = {"PoopPile"},
    ["パレット"] = {"PalletLightBrown"},
    ["スポッキー"] = {"SpookyCandle1"},
    ["花火"] = {"FireworkSparkler"},
    ["トイレット"] = {"ToiletWhite","ToiletGold"},
    ["なんか"] = {"TetracubeI"}
}

local wingList = {}
local wingLoop = nil
local wingAccum = 0

local function nameInTargets(n)
    local t = TargetSets[config.Wings.TargetSet]
    if not t then return false end
    for _, nm in ipairs(t) do
        if n == nm then return true end
    end
    return false
end

local function attachWingPhysics(rec)
    local model, part = rec.model, rec.part
    if not model or not part or not part.Parent then return end
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            pcall(function() p:SetNetworkOwner(LP) end)
            p.CanCollide = false
            p.CanTouch = false
            p.CanQuery = false
        end
    end
    if not part:FindFirstChild("BodyVelocity") then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "BodyVelocity"
        bv.MaxForce = Vector3.new(1e8, 1e8, 1e8)
        bv.Velocity = Vector3.new()
        bv.P = 1e6
        bv.Parent = part
    end
    if not part:FindFirstChild("BodyGyro") then
        local bg = Instance.new("BodyGyro")
        bg.Name = "BodyGyro"
        bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
        bg.CFrame = part.CFrame
        bg.P = 1e6
        bg.Parent = part
    end
end

local function detachWingPhysics(rec)
    local model, part = rec.model, rec.part
    if not model or not part then return end
    local bv = part:FindFirstChild("BodyVelocity")
    if bv then bv:Destroy() end
    local bg = part:FindFirstChild("BodyGyro")
    if bg then bg:Destroy() end
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = true
            p.CanTouch = true
            p.CanQuery = true
            pcall(function() p:SetNetworkOwner(nil) end)
        end
    end
end

local function rescanWings()
    for _, r in ipairs(wingList) do detachWingPhysics(r) end
    wingList = {}
    local tset = TargetSets[config.Wings.TargetSet]
    if not tset then return false end
    local root = HRP()
    if not root then return false end
    local playerPos = root.Position
    local candidates = {}
    for _, d in ipairs(W:GetDescendants()) do
        if d:IsA("Model") and nameInTargets(d.Name) then
            local part = getPartFromModel(d)
            if part and not part.Anchored then
                local distance = (part.Position - playerPos).Magnitude
                if distance <= 500 then
                    table.insert(candidates, {model = d, part = part, distance = distance})
                end
            end
        end
    end
    table.sort(candidates, function(a, b) return a.distance < b.distance end)
    local totalFound = #candidates
    if totalFound == 0 then return false end
    for i = 1, totalFound do
        local candidate = candidates[i]
        local isRight = (i % 2 == 1)
        local wingIndex = math.ceil(i / 2)
        local rec = {model = candidate.model, part = candidate.part, isRight = isRight, wingIndex = wingIndex}
        table.insert(wingList, rec)
        attachWingPhysics(rec)
    end
    return #wingList > 0
end

local function startWingLoop()
    if wingLoop then wingLoop:Disconnect() wingLoop = nil end
    wingAccum = 0
    wingLoop = RunService.Heartbeat:Connect(function(dt)
        local root = HRP()
        if not root or #wingList == 0 then return end
        wingAccum = wingAccum + dt
        local HRP_CF = root.CFrame
        local HRP_POS = root.Position
        local rightWingCount = 0
        local leftWingCount = 0
        for _, rec in ipairs(wingList) do
            if rec.isRight then rightWingCount = rightWingCount + 1
            else leftWingCount = leftWingCount + 1 end
        end
        for _, rec in ipairs(wingList) do
            local part = rec.part
            if not part or not part.Parent then continue end
            local isRight = rec.isRight
            local wingIndex = rec.wingIndex
            local sideMult = isRight and 1 or -1
            local wingTotal = isRight and rightWingCount or leftWingCount
            local normalizedPos = (wingIndex - 1) / math.max(1, wingTotal - 1)
            local lateralOffset = (wingIndex - 1) * config.Wings.Spacing
            local wavePhase = wingAccum * config.Wings.WaveSpeed - normalizedPos * 3.0
            local waveIntensity = normalizedPos
            local waveOffset = math.sin(wavePhase) * config.Wings.WaveAmplitude * waveIntensity
            local twistPhase = wingAccum * config.Wings.TwistSpeed + normalizedPos * config.Wings.TwistWaveLength * math.pi * 2
            local twistIntensity = normalizedPos
            local twistAngle = math.rad(math.sin(twistPhase) * config.Wings.MaxTwistAngle * twistIntensity)
            local localX = (lateralOffset + config.Wings.SideOffset) * sideMult
            local localY = config.Wings.WingHeight + waveOffset
            local localZ = config.Wings.BackOffset
            local targetPos = HRP_CF * CFrame.new(localX, localY, localZ)
            local lookDir = (HRP_POS - targetPos.p).Unit
            local rightDir = HRP_CF.RightVector * sideMult
            local upDir = lookDir:Cross(rightDir).Unit
            local baseCF = CFrame.lookAt(targetPos.p, targetPos.p + lookDir)
            local finalCF = baseCF * CFrame.Angles(0, 0, twistAngle)
            local dir = targetPos.p - part.Position
            local dist = dir.Magnitude
            local bv = part:FindFirstChild("BodyVelocity")
            if bv then
                bv.Velocity = (dist > 0.02) and dir.Unit * math.min(config.Wings.MaxVel, dist * config.Wings.Strength) or Vector3.new()
            end
            local bg = part:FindFirstChild("BodyGyro")
            if bg then bg.CFrame = finalCF end
        end
    end)
end

local function stopWingLoop()
    if wingLoop then wingLoop:Disconnect() wingLoop = nil end
end

