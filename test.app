end)
workspace.DescendantRemoving:Connect(function(Descendant)
    if pvpState.HRPs[Descendant] then
        pvpState.HRPs[Descendant] = nil
        if pvpState.LastGrabbedTarget == Descendant then
            pvpState.LastGrabbedTarget = nil
        end
    end
end)
for _, Descendant in workspace:GetDescendants() do
    if Descendant:IsA("BasePart") and Descendant.Name == "HumanoidRootPart" then
        if Descendant ~= pvpState.Root then
            pvpState.HRPs[Descendant] = true
        end
    end
end

if LP.Character then
    UpdateCharacter(LP.Character)
end
LP.CharacterAdded:Connect(UpdateCharacter)

-- サイレントエイムループ
RunService.RenderStepped:Connect(function()
    if not pvpState.CameraInitialized then
        return
    end
    local TargetCFrame = pvpState.CameraClone.CFrame
    if config.PvP.SilentAimEnabled and not workspace:FindFirstChild("GrabParts") then
        local Target = GetTarget()
        if Target and Target ~= pvpState.Root then
            local Screen3D, OnScreen = Camera:WorldToScreenPoint(Target.Position)
            if OnScreen then
                if TargetCFrame.LookVector:Dot((Target.Position - TargetCFrame.Position).Unit) > 0 then
                    TargetCFrame = CFrame.new(TargetCFrame.Position, Target.Position)
                end
            end
        end
    end
    Camera.CFrame = TargetCFrame
end)

-- 自動掴みループ
RunService.Heartbeat:Connect(function()
    -- Antikill Ultra（毎フレーム100回）
    if config.Anti.Antikill and LP.Character then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        if hum and hrp then
            for i = 1, config.Anti.AntikillLoops do
                if hum.Health ~= config.Anti.AntikillHealth then hum.Health = config.Anti.AntikillHealth end
                if hum.Health <= 0 then hum.Health = config.Anti.AntikillHealth end
                if config.Anti.AntikillDeath and hum.Health > 0 and hum:GetState() == Enum.HumanoidStateType.Dead then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
                if config.Anti.AntikillFall then
                    local vel = hrp.Velocity
                    if vel.Y < 0 then hrp.Velocity = Vector3.new(vel.X, 0, vel.Z) end
                    if config.Anti.AntikillKnock then
                        local maxSpeed = 50
                        if math.abs(vel.X) > maxSpeed or math.abs(vel.Z) > maxSpeed then
                            hrp.Velocity = Vector3.new(math.clamp(vel.X, -maxSpeed, maxSpeed), math.clamp(vel.Y, -maxSpeed, 0), math.clamp(vel.Z, -maxSpeed, maxSpeed))
                        end
                    end
                end
            end
        end
    end
    if not config.PvP.AutoGrabEnabled then return end
    if pvpState.GrabbedPart then return end
    if tick() - pvpState.LastGrabTime < pvpState.GrabCooldown then return end
    local Target = GetAutoGrabTarget()
    if Target and Target.Parent then
        local Center = Camera.ViewportSize / 2
        VirtualUser:ClickButton1(Center, Camera.CFrame)
        pvpState.LastGrabTime = tick()
        pvpState.LastGrabbedTarget = Target
        pvpState.LastGrabbedTime = tick()
    end
end)

-- GrabParts検知
workspace.ChildAdded:Connect(function(GrabParts)
    if not (GrabParts.Name == "GrabParts" and GrabParts:IsA("Model")) then return end
    local GrabPart = GrabParts:WaitForChild("GrabPart", 3)
    local WeldConstraint = (GrabPart) and GrabPart:WaitForChild("WeldConstraint", 3)
    local Target = (WeldConstraint) and WeldConstraint.Part1
    if not (Target and Target:IsDescendantOf(workspace)) then return end
    pvpState.GrabbedPart = Target
    local Removed
    Removed = GrabParts.AncestryChanged:Connect(function()
        if GrabParts:IsDescendantOf(workspace) then return end
        pvpState.GrabbedPart = nil
        if Removed then
            Removed:Disconnect()
            Removed = nil
        end
    end)
end)
