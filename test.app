})

-- Anti-Ragdoll
megaInvSection3:AddToggle({
    Name = "Anti-Ragdoll",
    Default = false,
    Callback = function(Value)
        megaProtectionEnabled = Value
        megaProtConnections = megaProtConnections or {}

        local function clearConnections()
            for _, conn in ipairs(megaProtConnections) do
                if conn then conn:Disconnect() end
            end
            megaProtConnections = {}
        end

        local function protectHumanoid(humanoid)
            humanoid.BreakJointsOnDeath = false
            humanoid.AutoRotate = true
            humanoid.PlatformStand = false

            table.insert(megaProtConnections, humanoid.HealthChanged:Connect(function(health)
                if megaProtectionEnabled and health <= 0 then
                    humanoid.Health = 1
                end
            end))
            table.insert(megaProtConnections, humanoid:GetPropertyChangedSignal("AutoRotate"):Connect(function()
                if megaProtectionEnabled and not humanoid.AutoRotate then
                    humanoid.AutoRotate = true
                end
            end))
            table.insert(megaProtConnections, humanoid:GetPropertyChangedSignal("PlatformStand"):Connect(function()
                if megaProtectionEnabled and humanoid.PlatformStand then
                    humanoid.PlatformStand = false
                end
            end))
            table.insert(megaProtConnections, game:GetService("RunService").RenderStepped:Connect(function()
                if megaProtectionEnabled and humanoid.Sit and humanoid.SeatPart == nil then
                    humanoid.Sit = false
                end
            end))
        end

        local function onCharacter(char)
            local humanoid = char:WaitForChild("Humanoid", 5)
            if humanoid and megaProtectionEnabled then
                protectHumanoid(humanoid)
            end
        end

        if megaProtectionEnabled then
            local character = LocalPlayer.Character
            if character then onCharacter(character) end
            megaCharAddedConn = LocalPlayer.CharacterAdded:Connect(onCharacter)
        else
            clearConnections()
            if megaCharAddedConn then
                megaCharAddedConn:Disconnect()
                megaCharAddedConn = nil
            end
        end
    end,
    Save = true,
    Flag = "mega_antiragdoll_toggle"
})

-- Anti-Paint
megaInvSection3:AddToggle({
    Name = "Anti-Paint",
    Default = false,
    Callback = function(state)
        local function setTouchQuery(s)
            local char = LocalPlayer.Character
            if char then
                for _, v in ipairs(char:GetChildren()) do
                    if v:IsA("BasePart") then
                        v.CanTouch = s
                        v.CanQuery = s
                    end
                end
            end
        end

        if state then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Name == "PaintPlayerPart" then
                    local clone = obj:Clone()
                    clone.Archivable = true
                    megaPaintPartsBackup[obj:GetDebugId()] = { clone = clone, parent = obj.Parent }
                    obj:Destroy()
                end
            end
            local conn = workspace.DescendantAdded:Connect(function(obj)
                if obj:IsA("BasePart") and obj.Name == "PaintPlayerPart" then
                    task.defer(function()
                        if obj and obj.Parent then
                            local clone = obj:Clone()
                            clone.Archivable = true
                            megaPaintPartsBackup[obj:GetDebugId()] = { clone = clone, parent = obj.Parent }
                            obj:Destroy()
                        end
                    end)
                end
            end)
            table.insert(megaPaintConnections, conn)
            setTouchQuery(false)
        else
            for _, conn in ipairs(megaPaintConnections) do
                if conn.Connected then conn:Disconnect() end
            end
            megaPaintConnections = {}
            for id, data in pairs(megaPaintPartsBackup) do
                if data.clone and data.parent then
                    data.clone.Parent = data.parent
                end
            end
            megaPaintPartsBackup = {}
            setTouchQuery(true)
        end
    end,
    Save = true,
    Flag = "mega_antipaint_toggle"
})


-- ================= Grab Tab (EggHub版) =================

-- ======================================================
-- EggHub v1.0 - 統合版 (Grab + Anti + Aura)
-- Grab機能 / Anti機能 / Aura機能 完全統合
-- UI: OrionLib
-- ======================================================

-- サービス取得
local Services = {
    Players        = game:GetService("Players"),
    RunService     = game:GetService("RunService"),
    ReplicatedStorage = game:GetService("ReplicatedStorage"),
    UserInputService  = game:GetService("UserInputService"),
    Debris         = game:GetService("Debris"),
    Workspace      = game:GetService("Workspace"),
    TweenService   = game:GetService("TweenService"),
    Lighting       = game:GetService("Lighting"),
}

-- OrionLib 読み込み

-- プレイヤー変数
local LP = Services.Players.LocalPlayer
local function getChar() return LP.Character end
local function getRoot()
    local c = getChar(); if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")
end
local function getHum()
    local c = getChar(); if not c then return nil end
    return c:FindFirstChildOfClass("Humanoid")
end

-- キャラクター更新
local playerCharacter = LP.Character or LP.CharacterAdded:Wait()
LP.CharacterAdded:Connect(function(c) playerCharacter = c end)

-- サーバーイベント
local RS = Services.ReplicatedStorage
local GrabEvents      = RS:WaitForChild("GrabEvents")
local MenuToys        = RS:WaitForChild("MenuToys")
local CharacterEvents = RS:WaitForChild("CharacterEvents")
local SetNetworkOwner = GrabEvents:WaitForChild("SetNetworkOwner")
local CreateLine      = GrabEvents:WaitForChild("CreateGrabLine")
local DestroyLine     = GrabEvents:WaitForChild("DestroyGrabLine")
local DestroyToy      = MenuToys:WaitForChild("DestroyToy")
local Struggle        = CharacterEvents:WaitForChild("Struggle")
local RagdollRemote   = CharacterEvents:FindFirstChild("RagdollRemote")

-- グローバル変数
_G.BlobmanDelay = 0.005
_G.strength     = 500
_G.Aurahowait   = false

-- 主要変数
local Vars = {
    -- Aura設定
    auraRadius  = 20,
    auraSpeed   = 0,
    auraToggle  = 1, -- 1=Silent, 2=Sky (Kick Aura mode)

    -- Kick Grab用
    kickGrabConnections = {},

    -- Grab flags (workspace.ChildAdded で使用)
    grabFlags = {
        KillGrab      = false,
        SkyGrab       = false,
        SpinGrab      = false,
        FreezeGrab    = false,
        FlingGrab     = false,
        VoidGrab      = false,
        PoisonGrab    = false,
        RagdollGrab   = false,
        NoclipGrab    = false,
        FireGrab      = false,
        KickGrab      = false,
    },

    -- Anti flags
    antiKill     = false,
    antiFling    = false,
    antiVoid     = false,
    antiGrab     = false,
    antiKickGrab = false,
    antiExplode  = false,
    antiFire     = false,
    antiBlobman  = false,
    antiLag      = false,
    gucciAnti    = false,

    -- Aura flags
    killAuraOn     = false,
    skyAuraOn      = false,
    flingAuraOn    = false,
    voidAuraOn     = false,
    spinAuraOn     = false,
    freezeAuraOn   = false,
    poisonAuraOn   = false,
    ragdollAuraOn  = false,
    bringAuraOn    = false,
    repelAuraOn    = false,
    magnetAuraOn   = false,
    airSuspAuraOn  = false,
    hellSendAuraOn = false,
    kickAuraOn     = false,

    repelForce  = 100,
    magnetRange = 50,

    -- 接続管理
    antiConnections = {},
    platforms = {},
}

-- ──────────────────────────────────────────────
-- ユーティリティ関数
-- ──────────────────────────────────────────────
local function SNO(part)
    pcall(function()
        local r = getRoot()
        if r then SetNetworkOwner:FireServer(part, r.CFrame) end
    end)
end

local function Velocity(part, vec)
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.one * math.huge
    bv.Velocity  = vec
    bv.Parent    = part
    Services.Debris:AddItem(bv, 1)
end

local function getInv()
    return Services.Workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
end

local function getNearestPlayer()
    local nearest, dist = nil, math.huge
    for _, p in pairs(Services.Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local d = (playerCharacter.HumanoidRootPart.Position
                     - p.Character.HumanoidRootPart.Position).Magnitude
            if d < dist then dist = d; nearest = p end
        end
    end
    return nearest
end

local function isFriend(p)
    if not _G.Aurahowait then return false end
    return pcall(function() return LP:IsFriendsWith(p.UserId) end)
        and LP:IsFriendsWith(p.UserId)
end

-- PoisonHurtPart取得
local function getPoisonParts()
    local parts = {}
    pcall(function()
        for _, d in ipairs(Services.Workspace.Map:GetDescendants()) do
            if d:IsA("Part") and d.Name == "PoisonHurtPart" then
                table.insert(parts, d)
            end
        end
    end)
    return parts
end
local poisonHurtParts = getPoisonParts()

-- ──────────────────────────────────────────────
-- 攻撃関数テーブル (Aura / Loop から共通で使用)
-- ──────────────────────────────────────────────
local AttackFn = {
    kill = function(p)
        if not (p and p.Character) then return end
        local hrp   = p.Character:FindFirstChild("HumanoidRootPart")
        local torso = p.Character:FindFirstChild("Torso")
        pcall(function()
            if hrp then SNO(hrp) end
            if torso then
                SNO(torso)
                for _, m in pairs(torso:GetChildren()) do
                    if m:IsA("Motor6D") then m:Destroy() end
                end
                p.Character:BreakJoints()
            end
        end)
    end,

    sky = function(p, power)
        if not (p and p.Character) then return end
        local t = p.Character:FindFirstChild("Torso")
               or p.Character:FindFirstChild("HumanoidRootPart")
        if t then
            SNO(t)
            local bv = Instance.new("BodyVelocity", t)
            bv.Velocity = Vector3.new(0, power or 100, 0)
            bv.MaxForce = Vector3.one * math.huge
            Services.Debris:AddItem(bv, 3)
        end
    end,

    fling = function(p)
        if not (p and p.Character) then return end
        local t = p.Character:FindFirstChild("Torso")
        if t then
            SNO(t)
            local bv = Instance.new("BodyVelocity", t)
            bv.Velocity = Vector3.new(
                math.random(-1,1)*5e10, 5e15, math.random(-1,1)*5e10)
            bv.MaxForce = Vector3.one * math.huge
            Services.Debris:AddItem(bv, 2)
        end
    end,

    void = function(p)
        if not (p and p.Character) then return end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            SNO(hrp)
            for _, part in ipairs(p.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
            Velocity(hrp, Vector3.new(0, -1000, 0))
        end
    end,

    spin = function(p, speed)
        if not (p and p.Character) then return end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            SNO(hrp)
            local bav = Instance.new("BodyAngularVelocity", hrp)
            bav.AngularVelocity = Vector3.new(0, speed or 150, 0)
            bav.MaxTorque = Vector3.one * math.huge
            Services.Debris:AddItem(bav, 3)
        end
    end,

    freeze = function(p)
        if not (p and p.Character) then return end
        local t = p.Character:FindFirstChild("Torso")
               or p.Character:FindFirstChild("HumanoidRootPart")
        if t then
            SNO(t)
            local bp = Instance.new("BodyPosition", t)
            bp.Position  = t.Position
            bp.MaxForce  = Vector3.one * math.huge
            bp.P         = 1e6
            Services.Debris:AddItem(bp, 5)
        end
    end,

    poison = function(p)
        if not (p and p.Character) then return end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if hrp and #poisonHurtParts > 0 then
            SNO(hrp)
            for _, part in pairs(poisonHurtParts) do
                part.Size = Vector3.new(2, 2, 2)
                part.Transparency = 1
                part.Position = hrp.Position
            end
            task.wait()
            for _, part in pairs(poisonHurtParts) do
                part.Position = Vector3.new(0, -200, 0)
            end
        end
    end,

    ragdoll = function(p)
        if not (p and p.Character) then return end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if hrp and RagdollRemote then
            pcall(function() RagdollRemote:FireServer(hrp, 999999) end)
        end
    end,

    bring = function(p)
        if not (p and p.Character) then return end
        local hrp   = p.Character:FindFirstChild("HumanoidRootPart")
        local myR   = getRoot()
        if hrp and myR then
            SNO(hrp)
            hrp.CFrame = myR.CFrame + myR.CFrame.LookVector * 5
        end
    end,

    repel = function(p, force)
        if not (p and p.Character) then return end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        local myR = getRoot()
        if hrp and myR then
            SNO(hrp)
            local dir = (hrp.Position - myR.Position).Unit
            local bv = Instance.new("BodyVelocity", hrp)
            bv.Velocity  = dir * (force or 100)
            bv.MaxForce  = Vector3.one * math.huge
            Services.Debris:AddItem(bv, 0.2)
        end
    end,

    magnet = function(p)
        if not (p and p.Character) then return end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        local myR = getRoot()
        if hrp and myR then
            SNO(hrp)
            local dir = (myR.Position - hrp.Position).Unit
            local bv = Instance.new("BodyVelocity", hrp)
            bv.Velocity  = dir * 50
            bv.MaxForce  = Vector3.one * math.huge
            Services.Debris:AddItem(bv, 0.2)
        end
    end,
}

-- ──────────────────────────────────────────────
-- Grab補助関数
-- ──────────────────────────────────────────────
local function arson(part)
    pcall(function()
        local inv = getInv()
        if not inv:FindFirstChild("Campfire") then
            RS.MenuToys.SpawnToyRemoteFunction:InvokeServer(
                "Campfire",
                CFrame.new(part.Position),
                Vector3.new(0,0,0)
            )
        end
        local campfire = inv:WaitForChild("Campfire", 5)
        if campfire then
            local fpp = campfire:FindFirstChild("FirePlayerPart")
            if fpp then
                fpp.Size = Vector3.new(7, 7, 7)
                fpp.Position = part.Position
                task.wait(0.3)
                fpp.Position = Vector3.new(0, -50, 0)
            end
        end
    end)
end

local function noclipGrabLoop()
    while true do
        pcall(function()
            local gp = Services.Workspace:FindFirstChild("GrabParts")
            if gp then
                local grabPart = gp:FindFirstChild("GrabPart")
                if grabPart and grabPart:FindFirstChild("WeldConstraint") then
                    local char = grabPart.WeldConstraint.Part1
                               and grabPart.WeldConstraint.Part1.Parent
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        while Services.Workspace:FindFirstChild("GrabParts") do
                            for _, p in pairs(char:GetChildren()) do
                                if p:IsA("BasePart") then p.CanCollide = false end
                            end
                            task.wait()
                        end
                        for _, p in pairs(char:GetChildren()) do
                            if p:IsA("BasePart") then p.CanCollide = true end
                        end
                    end
                end
            end
        end)
        task.wait()
    end
end

-- Kick Grab補助
local function handleCharacterKickGrab(player)
    local conn = player.CharacterAdded:Connect(function(character)
        local hrp = character:WaitForChild("HumanoidRootPart")
        local fpp = hrp:WaitForChild("FirePlayerPart", 5)
        if fpp then
            fpp.Size = Vector3.new(4.5, 5, 4.5)
            fpp.CollisionGroup = "1"
            fpp.CanQuery = true
        end
    end)
    table.insert(Vars.kickGrabConnections, conn)
end

local function enableKickGrab()
    for _, player in pairs(Services.Players:GetPlayers()) do
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local fpp = hrp:FindFirstChild("FirePlayerPart")
            if fpp then
                fpp.Size = Vector3.new(4.5, 5.5, 4.5)
                fpp.CollisionGroup = "1"
                fpp.CanQuery = true
            end
        end
        handleCharacterKickGrab(player)
    end
    local paConn = Services.Players.PlayerAdded:Connect(handleCharacterKickGrab)
    table.insert(Vars.kickGrabConnections, paConn)
end

local function disableKickGrab()
    for _, conn in pairs(Vars.kickGrabConnections) do conn:Disconnect() end
    Vars.kickGrabConnections = {}
    for _, player in pairs(Services.Players:GetPlayers()) do
        pcall(function()
            local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            local fpp = hrp and hrp:FindFirstChild("FirePlayerPart")
            if fpp then
                fpp.Size = Vector3.new(2.5, 5.5, 2.5)
                fpp.CollisionGroup = "Default"
                fpp.CanQuery = false
            end
        end)
    end
end

-- ──────────────────────────────────────────────
-- Grab: workspace.ChildAdded ハンドラ
-- ──────────────────────────────────────────────
local noclipGrabCo = nil

-- ──────────────────────────────────────────────
-- Strength: モバイル対応 (投げる直前の右タップ検知)
-- ──────────────────────────────────────────────
local strengthLastThrow = false  -- 直前にグラブ解放したか

-- モバイル: 画面右半分タップで投げ判定
-- PC: MouseButton2で投げ判定
local function isThrowInput()
    local UIS = Services.UserInputService
    if UIS.TouchEnabled then
        return strengthLastThrow  -- TouchEnd時にセット
    else
        return UIS:GetLastInputType() == Enum.UserInputType.MouseButton2
    end
end

-- モバイル用: タッチ終了時に右半分タップかどうか記録
Services.UserInputService.TouchEnded:Connect(function(touch, _)
    local screenSize = Services.Workspace.CurrentCamera.ViewportSize
    if touch.Position.X > screenSize.X * 0.5 then
        strengthLastThrow = true
        task.delay(0.3, function() strengthLastThrow = false end)
    end
end)

-- ──────────────────────────────────────────────
-- Grab: workspace.ChildAdded ハンドラ
-- WeldConstraint.Part1 はChildAdded直後にnilのことがあるため
-- task.wait()後に再確認する
-- ──────────────────────────────────────────────
Services.Workspace.ChildAdded:Connect(function(model)
    if model.Name ~= "GrabParts" then return end
    task.spawn(function()
        -- WeldConstraintが設定されるまで少し待つ
        local grabPart = model:WaitForChild("GrabPart", 1)
        if not grabPart then return end
        task.wait()  -- Part1がセットされるのを待つ

        local wc    = grabPart:FindFirstChild("WeldConstraint")
        local part1 = wc and wc.Part1

        -- まだnilなら追加フレーム待機
        if not part1 then
            task.wait()
            wc    = grabPart:FindFirstChild("WeldConstraint")
            part1 = wc and wc.Part1
        end

        -- 自分自身のGrabPartsには反応しない（体が荒ぶるバグ修正）
        if part1 and LP.Character and part1:IsDescendantOf(LP.Character) then return end
        -- grabPart自体が自分のキャラに属している場合もスキップ
        if grabPart and LP.Character and grabPart:IsDescendantOf(LP.Character) then return end
        -- モデル自体が自分のキャラ内なら除外
        if model and LP.Character and model:IsDescendantOf(LP.Character) then return end

        -- Kill Grab
        if Vars.grabFlags.KillGrab and part1 then
            pcall(function() part1.Parent:BreakJoints() end)
        end
        -- Sky Grab
        if Vars.grabFlags.SkyGrab and part1 then
            local bv = Instance.new("BodyVelocity", part1)
            bv.Velocity  = Vector3.new(0, 100, 0)
            bv.MaxForce  = Vector3.new(0, math.huge, 0)
            Services.Debris:AddItem(bv, 1.5)
        end
        -- Spin Grab
        if Vars.grabFlags.SpinGrab and part1 then
            pcall(function()
                local bav = Instance.new("BodyAngularVelocity", part1)
                bav.AngularVelocity = Vector3.new(0, 1000, 0)
                bav.MaxTorque = Vector3.one * math.huge
            end)
        end
        -- Freeze Grab
        if Vars.grabFlags.FreezeGrab and part1 then
            for _, c in ipairs(model:GetDescendants()) do
                if c:IsA("BasePart") then c.Anchored = true end
            end
        end
        -- Fling Grab
        if Vars.grabFlags.FlingGrab and part1 then
            pcall(function()
                SNO(part1)
                Velocity(part1, Vector3.new(
                    math.random(-100,100), 200, math.random(-100,100)))
            end)
        end
        -- Void Grab
        if Vars.grabFlags.VoidGrab and part1 then
            pcall(function()
                SNO(part1)
                Velocity(part1, Vector3.new(0, -500, 0))
            end)
        end
        -- Poison Grab
        if Vars.grabFlags.PoisonGrab and part1 then
            pcall(function()
                local head = part1.Parent:FindFirstChild("Head")
                if head and #poisonHurtParts > 0 then
                    while Services.Workspace:FindFirstChild("GrabParts") do
                        for _, p in pairs(poisonHurtParts) do
                            p.Size = Vector3.new(2, 2, 2)
                            p.Transparency = 1
                            p.Position = head.Position
                        end
                        task.wait()
                        for _, p in pairs(poisonHurtParts) do
                            p.Position = Vector3.new(0, -200, 0)
                        end
                    end
                end
            end)
        end
        -- Ragdoll Grab
        if Vars.grabFlags.RagdollGrab and part1 and RagdollRemote then
            pcall(function() RagdollRemote:FireServer(part1, 999999) end)
        end
        -- Fire Grab
        if Vars.grabFlags.FireGrab and part1 then
            pcall(function()
                local head = part1.Parent:FindFirstChild("Head")
                if head then arson(head) end
            end)
        end
        -- Noclip Grab (コルーチン)
        if Vars.grabFlags.NoclipGrab then
            if noclipGrabCo and coroutine.status(noclipGrabCo) ~= "dead" then
                coroutine.close(noclipGrabCo)
            end
            noclipGrabCo = coroutine.create(noclipGrabLoop)
            coroutine.resume(noclipGrabCo)
        end
        -- Strength (投げる強化) - モバイル対応
        if Vars.grabFlags.StrengthEnabled and part1 then
            local velocityObj = Instance.new("BodyVelocity", part1)
            model:GetPropertyChangedSignal("Parent"):Connect(function()
                if not model.Parent then
                    if isThrowInput() then
                        velocityObj.MaxForce = Vector3.one * math.huge
                        velocityObj.Velocity =
                            Services.Workspace.CurrentCamera.CFrame.LookVector
                            * _G.strength
                        Services.Debris:AddItem(velocityObj, 1)
                    else
                        velocityObj:Destroy()
                    end
                end
            end)
        end
    end)
end)

-- ──────────────────────────────────────────────
-- Aura ループヘルパー
-- ──────────────────────────────────────────────
local function auraLoop(flagFn, action)
    task.spawn(function()
        while flagFn() do
            local root = getRoot()
            if root then
                for _, p in pairs(Services.Players:GetPlayers()) do
                    if p ~= LP and not isFriend(p) and p.Character then
                        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                            or p.Character:FindFirstChild("Torso")
                        if hrp and (hrp.Position - root.Position).Magnitude
                                <= Vars.auraRadius then
                            pcall(action, p)
                        end
                    end
                end
            end
            task.wait(Vars.auraSpeed)
        end
    end)
end

-- ──────────────────────────────────────────────
-- Gucci Anti (AntiGUCCI高速 移植)
-- ──────────────────────────────────────────────
local gucciAutoT        = false
local gucci_blobman     = nil
local gucci_lastSeat    = nil
local gucci_allowSeat   = false
local GUCCI_ANTI_DURATION = 3.2

local function gucci_getChar()
    return LP.Character or LP.CharacterAdded:Wait()
end
local function gucci_getBlobman()
    local f = Services.Workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
    return f and f:FindFirstChild("CreatureBlobman")
end
local function gucci_spawnBlobman()
    local char = gucci_getChar()
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    RS.MenuToys.SpawnToyRemoteFunction:InvokeServer(
        "CreatureBlobman",
        hrp.CFrame * CFrame.new(0, 0, -2),
        Vector3.new(0, -15.716, 0)
    )
    task.wait(0.25)
    gucci_blobman = gucci_getBlobman()
end
local function gucci_ensureBlobman()
    if not (gucci_blobman and gucci_blobman.Parent) then
        gucci_spawnBlobman()
    end
    return gucci_blobman
end
local function gucci_getPrimary()
    if not gucci_blobman then return end
    local p = gucci_blobman.PrimaryPart or gucci_blobman:FindFirstChildWhichIsA("BasePart")
    if p and not gucci_blobman.PrimaryPart then gucci_blobman.PrimaryPart = p end
    return p
end
local function gucci_seat_jump_ragdoll()
    local char = gucci_getChar()
    local hum  = char:FindFirstChildOfClass("Humanoid")
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp and gucci_blobman) then return end
    local seat = gucci_blobman:FindFirstChildWhichIsA("VehicleSeat")
    if not seat then return end
    gucci_lastSeat = seat
    local rag = RS.CharacterEvents.RagdollRemote
    gucci_allowSeat = true
    for i = 1, 400 do
        pcall(function()
            if gucci_allowSeat and seat.Occupant ~= hum then
                seat:Sit(hum)
            end
            rag:FireServer(hrp, 0)
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end)
    end
    gucci_allowSeat = false
end
local function gucci_runAnti(duration)
    local hrp   = gucci_getChar():FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local rag   = RS.CharacterEvents.RagdollRemote
    local start = tick()
    while gucciAutoT and tick() - start < duration do
        if not (gucci_blobman and gucci_blobman.Parent) then break end
        rag:FireServer(hrp, 0)
        task.wait(0.01)
    end
end
local function gucci_yeetUp()
    local p = gucci_getPrimary()
    if not p then return end
    pcall(function()
        RS.GrabEvents.SetNetworkOwner:FireServer(
            p, gucci_getChar().HumanoidRootPart.CFrame)
    end)
    if sethiddenproperty then
        sethiddenproperty(p, "NetworkIsSleeping", false)
    end
    for _, v in ipairs(gucci_blobman:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end
    local pos = p.Position
    p.CFrame = CFrame.new(pos.X, pos.Y + 1e8, pos.Z)
end
local function gucci_clearAll()
    gucci_allowSeat = false
    if gucci_blobman then
        RS.MenuToys.DestroyToy:FireServer(gucci_blobman)
    end
    gucci_blobman  = nil
    gucci_lastSeat = nil
end
local function gucci_runOnce()
    gucciAutoT = true
    gucci_ensureBlobman()
    if not gucci_blobman then return end
    gucci_seat_jump_ragdoll()
    gucci_runAnti(GUCCI_ANTI_DURATION)
    gucci_yeetUp()
    task.delay(0.5, function()
        if gucci_lastSeat and gucci_lastSeat.Parent then
            gucci_lastSeat:Destroy()
        end
    end)
end

-- ──────────────────────────────────────────────
-- Anti Blobman (Cosmic移植: Detector削除 + Massless解除)
-- ──────────────────────────────────────────────
local function removeDetectors()
    local root = getRoot()
    if not root then return end
    for _, v in pairs(Services.Workspace:GetDescendants()) do
        if v:IsA("BasePart")
        and (v.Name == "LeftDetector" or v.Name == "RightDetector")
        and (root.Position - v.Position).Magnitude > 10 then
            v:Destroy()
        end
    end
end

local function applyAntiMassless()
    while Vars.antiBlobman do
        if LP.Character then
            for _, v in ipairs(LP.Character:GetDescendants()) do
                if v:IsA("BasePart") and v.Massless then
                    v.Massless = false
                end
            end
        end
        task.wait(1)
    end
end

-- ──────────────────────────────────────────────
-- Anti Explode (Cosmic移植)
-- ──────────────────────────────────────────────
local antiExplodeConn = nil
local function setupAntiExplode()
    antiExplodeConn = Services.Workspace.ChildAdded:Connect(function(p)
        if p:IsA("Part") and p.Name == "Part" and Vars.antiExplode
        and LP.Character then
            local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
            local arm = LP.Character:FindFirstChild("Right Arm")
            if hrp and arm and (p.Position - hrp.Position).Magnitude <= 20 then
                hrp.Anchored = true
                task.wait(0.01)
                while arm:FindFirstChild("RagdollLimbPart")
                    and arm.RagdollLimbPart.CanCollide == true do
                    task.wait(0.001)
                end
                hrp.Anchored = false
            end
        end
    end)
end

-- Anti Fire (Cosmic移植)
local antiFireConn = nil
local function setupAntiFire()
    local ep = pcall(function() return Services.Workspace.Map.Hole.PoisonBigHole.ExtinguishPart end)
        and Services.Workspace.Map.Hole.PoisonBigHole.ExtinguishPart
    if not ep then return end
    local origPos = ep.Position
    antiFireConn = Services.RunService.Heartbeat:Connect(function()
        if not Vars.antiFire then
            ep.CFrame = CFrame.new(origPos)
            antiFireConn:Disconnect(); antiFireConn = nil
            return
        end
        pcall(function()
            local root = getRoot()
            if root then
                local fl = root:FindFirstChild("FireLight")
                local fe = root:FindFirstChild("FireParticleEmitter")
                if fl or fe then
                    ep.CFrame = CFrame.new(root.Position)
                else
                    ep.CFrame = CFrame.new(origPos)
                end
            end
        end)
    end)
end

-- ──────────────────────────────────────────────
-- Kick Aura (まぁまぁ強い 移植: Silent / Sky モード)
-- ──────────────────────────────────────────────
local kickAuraCo = nil
local function startKickAura()
    kickAuraCo = task.spawn(function()
        while Vars.kickAuraOn do
            pcall(function()
                local root = getRoot()
                if not root then return end
                for _, p in pairs(Services.Players:GetPlayers()) do
                    if p ~= LP and not isFriend(p) and p.Character then
                        local head = p.Character:FindFirstChild("Head")
                        if head and (head.Position - root.Position).Magnitude
                                <= Vars.auraRadius then
                            local fpp = p.Character.HumanoidRootPart
                                    and p.Character.HumanoidRootPart:FindFirstChild("FirePlayerPart")
                            if fpp then
                                SNO(fpp)
                                if Vars.auraToggle == 1 then
                                    -- Silent mode: invisible platform
                                    if not Vars.platforms[p] then
                                        local platform = Instance.new("Part")
                                        platform.Name = "FloatingPlatform"
                                        platform.Size = Vector3.new(5, 2, 5)
                                        platform.Anchored = true
                                        platform.Transparency = 1
                                        platform.CanCollide = true
                                        platform.Parent = p.Character
                                        Vars.platforms[p] = platform
                                    end
                                else
                                    -- Sky mode: BodyVelocity
                                    if not fpp:FindFirstChild("KickAuraVel") then
                                        local bv = Instance.new("BodyVelocity")
                                        bv.Name = "KickAuraVel"
                                        bv.Velocity = Vector3.new(0, 20, 0)
                                        bv.MaxForce = Vector3.one * math.huge
                                        bv.Parent = fpp
                                    end
                                end
                            end
                        end
                    end
                end
                -- Update platform positions (Silent mode)
                if Vars.auraToggle == 1 then
                    for player, platform in pairs(Vars.platforms) do
                        if player.Character and player.Character:FindFirstChild("Humanoid")
                        and player.Character.Humanoid.Health > 1 then
                            local phrp = player.Character.HumanoidRootPart
                            platform.Position = phrp.Position - Vector3.new(0, 3.994, 0)
                        else
                            pcall(function() platform:Destroy() end)
                            Vars.platforms[player] = nil
                        end
                    end
                end
            end)
            task.wait(0.02)
        end
        -- Cleanup
        for _, plat in pairs(Vars.platforms) do pcall(function() plat:Destroy() end) end
        Vars.platforms = {}
    end)
end

-- Air Suspend Aura (まぁまぁ強い 移植)
local function startAirSuspAura()
    task.spawn(function()
        while Vars.airSuspAuraOn do
            pcall(function()
                local root = getRoot()
                if not root then return end
                for _, p in pairs(Services.Players:GetPlayers()) do
                    if p ~= LP and not isFriend(p) and p.Character then
                        local torso = p.Character:FindFirstChild("Torso")
                        local fpp = p.Character.HumanoidRootPart
                                and p.Character.HumanoidRootPart:FindFirstChild("FirePlayerPart")
                        if torso and fpp
                        and (torso.Position - root.Position).Magnitude <= Vars.auraRadius then
                            SetNetworkOwner:FireServer(torso, fpp.CFrame)
                            task.wait(0.1)
                            local vel = torso:FindFirstChild("AirSuspVel")
                                     or Instance.new("BodyVelocity", torso)
                            vel.Name = "AirSuspVel"
                            vel.Velocity = Vector3.new(0, 50, 0)
                            vel.MaxForce = Vector3.new(0, math.huge, 0)
                            Services.Debris:AddItem(vel, 100)
                        end
                    end
                end
            end)
            task.wait(0.02)
        end
    end)
end

-- Hell Send Aura (まぁまぁ強い 移植)
local function startHellSendAura()
    task.spawn(function()
        while Vars.hellSendAuraOn do
            pcall(function()
                local root = getRoot()
                if not root then return end
                for _, p in pairs(Services.Players:GetPlayers()) do
                    if p ~= LP and not isFriend(p) and p.Character then
                        local torso = p.Character:FindFirstChild("Torso")
                        local fpp = root:FindFirstChild("FirePlayerPart")
                        if torso and fpp
                        and (torso.Position - root.Position).Magnitude <= Vars.auraRadius then
                            SNO(torso)
                            task.wait(0.1)
                            local force = torso:FindFirstChild("HellSendForce")
                                       or Instance.new("BodyForce")
                            force.Parent = torso
                            force.Name = "HellSendForce"
                            for _, part in ipairs(p.Character:GetDescendants()) do
                                if part:IsA("BasePart") then part.CanCollide = false end
                            end
                            force.Force = Vector3.new(0, 1200, 0)
                        end
                    end
                end
            end)
            task.wait(0.02)
        end
    end)
end

-- ──────────────────────────────────────────────
-- 起動時カメラ設定
-- ゲームがZoomDistanceを毎フレーム上書きするためHeartbeatで強制維持
-- CameraModeは変更しない（ラグドールバグ回避）
-- ──────────────────────────────────────────────
local ZOOM_MAX = 120000
local Camera = Services.Workspace.CurrentCamera

LP.CameraMaxZoomDistance = ZOOM_MAX
LP.CameraMinZoomDistance = 0.5

-- RenderSteppedで毎フレーム強制維持（ゲームの上書きを完全ブロック）
Services.RunService.RenderStepped:Connect(function()
    if Camera.CameraType ~= Enum.CameraType.Custom then
        Camera.CameraType = Enum.CameraType.Custom
    end
    if LP.CameraMaxZoomDistance ~= ZOOM_MAX then
        LP.CameraMaxZoomDistance = ZOOM_MAX
    end
    if LP.CameraMinZoomDistance ~= 0.5 then
        LP.CameraMinZoomDistance = 0.5
    end
    if LP.CameraMode ~= Enum.CameraMode.Classic then
        LP.CameraMode = Enum.CameraMode.Classic
    end
end)
-- キャラリスポーン後も再適用はPlayer用CharacterAddedで一括管理



