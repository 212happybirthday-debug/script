BlobmanTab:AddToggle({
    Name = "左手オール",
    Default = false,
    Color = Color3.fromRGB(255, 255, 0),
    Callback = function(enabled)
        if enabled then
            task.spawn(function()
                while enabled do
                    local blobman = findBlobmanForLocalPlayer()
                    if not blobman then task.wait(1) continue end

                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LP then
                            if isWhiteListed(plr) then continue end
                            blobGrabPlayer(plr, blobman, "Left")
                        end
                    end
                    task.wait(0.35)
                end
            end)
        end
    end
})

BlobmanTab:AddToggle({
    Name = "右手オール",
    Default = false,
    Color = Color3.fromRGB(255, 255, 0),
    Callback = function(enabled)
        if enabled then
            task.spawn(function()
                while enabled do
                    local blobman = findBlobmanForLocalPlayer()
                    if not blobman then task.wait(1) continue end

                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LP then
                            if isWhiteListed(plr) then continue end
                            blobGrabPlayer(plr, blobman, "Right")
                        end
                    end
                    task.wait(0.35)
                end
            end)
        end
    end
})

