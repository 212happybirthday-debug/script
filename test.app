AntiTab:AddSection({Name = "Gucci"})
local gucciActive = false
local gucciCurrentToy = nil
local gucciConnection = nil
local gucciOriginalPos = nil
local gucciTargetName = ""

local function clearRagdollForGucci()
    local char, hrp, hum = LP.Character, HRP(), getHum()
    if hrp and hum then
        pcall(function()
            if RagdollRemote then RagdollRemote:FireServer(hrp, 0) end
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end)
    end
end

local function gucciSequence(toy)
    if toy.Name ~= gucciTargetName then return end
    gucciCurrentToy = toy

    local hrp = HRP()
    local hum = getHum()
    if not (hrp and hum) then return end

    local seat = toy:FindFirstChildWhichIsA("VehicleSeat", true)
    if seat and hum then
        seat:Sit(hum)

        local start = tick()
        while tick() - start < 0.5 and gucciActive do
            pcall(function()
                if RagdollRemote then RagdollRemote:FireServer(hrp, 0) end
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end)
            RunService.Heartbeat:Wait()
        end

        local primary = toy.PrimaryPart or toy:FindFirstChild("HumanoidRootPart", true) or toy:FindFirstChild("Part", true)
        if primary and gucciActive then
            pcall(function()
                if primary.SetNetworkOwner then primary:SetNetworkOwner(LP) end
                sethiddenproperty(primary, "NetworkIsSleeping", false)
            end)
        end

        if gucciOriginalPos then
            hrp.CFrame = gucciOriginalPos
        end

        task.wait(0.1)
        if seat then seat:Destroy() end
    end
end

local function spawnGucciToy()
    if not gucciActive then return end
    pcall(function()
        if SpawnToyRemoteFunction then
            SpawnToyRemoteFunction:InvokeServer(gucciTargetName, CFrame.new(0, 1e15, 0), Vector3.new(0, -15.716, 0))
        end
    end)
end

local function startGucciSystem(toyName)
    if gucciConnection then gucciConnection:Disconnect() end
    gucciActive = true
    gucciTargetName = toyName
    gucciCurrentToy = nil

    local hrp = HRP()
    if hrp then
        gucciOriginalPos = hrp.CFrame
    end

    local inv = getInv()
    if not inv then return end

    gucciConnection = inv.ChildAdded:Connect(function(child)
        task.spawn(function() gucciSequence(child) end)
    end)

    task.spawn(function()
        while gucciActive do
            if not gucciCurrentToy or not gucciCurrentToy.Parent then
                spawnGucciToy()
            end
            task.wait(1)
        end
    end)
end

local function stopGucciSystem()
    gucciActive = false
    if gucciConnection then
        gucciConnection:Disconnect()
        gucciConnection = nil
    end
    gucciCurrentToy = nil
    gucciOriginalPos = nil
    clearRagdollForGucci()
end

