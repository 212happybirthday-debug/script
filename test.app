-- =============================================
-- トイモッドタブ (Poop Controller ロジック移植)
-- =============================================
local ToyModTab = Window:MakeTab({Name = "トイモッド", Icon = "rbxassetid://4483362458"})

local toymod_poops = {}
local toymod_loopConn = nil
local toymod_phase = "idle"
local toymod_phaseTime = 0
local toymod_orbitRadius = 10
local toymod_surroundRadius = 15
local toymod_shootSpeed = 200
local toymod_rotationSpeed = 2
local toymod_selectedObject = "Poop"

local ToyModObjectSets = {
    ["Poop"]      = {"PoopPile"},
    ["Sparkler"]  = {"FireworkSparkler"},
    ["Toilet"]    = {"ToiletWhite", "ToiletGold"},
    ["Pallet"]    = {"PalletLightBrown"},
    ["GlassBox"]  = {"GlassBoxGray"},
    ["Spooky"]    = {"SpookyCandle1"},
    ["Tetracube"] = {"TetracubeI"}
}

local function toymod_isTarget(name)
    local targets = ToyModObjectSets[toymod_selectedObject]
    if not targets then return false end
    for _, t in ipairs(targets) do
        if name == t then return true end
    end
    return false
end

local function toymod_getPart(model)
    return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
end

local function toymod_teleportToSphere()
    local root = HRP()
    if not root then return end
    local count = #toymod_poops
    local phi = math.pi * (math.sqrt(5) - 1)
    for i, objData in ipairs(toymod_poops) do
        local baseY     = 1 - (i / math.max(count - 1, 1)) * 2
        local radiusAtY = math.sqrt(math.max(0, 1 - baseY * baseY))
        local theta     = phi * i
        local x = math.cos(theta) * radiusAtY
        local z = math.sin(theta) * radiusAtY
        local targetPos = root.Position + Vector3.new(
            x * toymod_surroundRadius,
            baseY * toymod_surroundRadius,
            z * toymod_surroundRadius
        )
        pcall(function() objData.part.CFrame = CFrame.new(targetPos) end)
    end
end

local function toymod_stopAll()
    if toymod_loopConn then toymod_loopConn:Disconnect() toymod_loopConn = nil end
    for _, objData in ipairs(toymod_poops) do
        pcall(function()
            local bv = objData.part:FindFirstChild("BodyVelocity")
            if bv then bv:Destroy() end
        end)
    end
    toymod_poops = {}
    toymod_phase = "idle"
end

local function toymod_collectAndTeleport()
    toymod_poops = {}
    local root = HRP()
    if not root then return false end
    local temp = {}
    for _, obj in ipairs(W:GetDescendants()) do
        if obj:IsA("Model") and toymod_isTarget(obj.Name) then
            local part = toymod_getPart(obj)
            if part and not part.Anchored then
                table.insert(temp, {
                    model = obj,
                    part  = part,
                    dist  = (part.Position - root.Position).Magnitude,
                    name  = obj.Name
                })
            end
        end
    end
    if #temp == 0 then return false end
    table.sort(temp, function(a, b) return a.dist < b.dist end)
    for i, data in ipairs(temp) do
        local angle = (i / #temp) * math.pi * 2
        local targetPos = root.Position + Vector3.new(
            math.cos(angle) * toymod_orbitRadius,
            0,
            math.sin(angle) * toymod_orbitRadius
        )
        pcall(function()
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.one * math.huge
            bv.Velocity  = Vector3.new(0, 0, 0)
            bv.Parent    = data.part
            data.part.CFrame = CFrame.new(targetPos)
        end)
        table.insert(toymod_poops, data)
    end
    toymod_phase     = "orbit"
    toymod_phaseTime = 0
    return true
end

local function toymod_startLoop()
    if toymod_loopConn then toymod_loopConn:Disconnect() end
    toymod_loopConn = RunService.Heartbeat:Connect(function(dt)
        local root = HRP()
        if not root or #toymod_poops == 0 then return end
        toymod_phaseTime = toymod_phaseTime + dt

        if toymod_phase == "orbit" and toymod_phaseTime >= 3 then
            toymod_phase     = "surround"
            toymod_phaseTime = 0
            toymod_teleportToSphere()
        elseif toymod_phase == "surround" and toymod_phaseTime >= 5 then
            toymod_phase     = "shoot"
            toymod_phaseTime = 0
        end

        if toymod_phase == "orbit" then
            for i, objData in ipairs(toymod_poops) do
                local angle     = (i / #toymod_poops) * math.pi * 2 + toymod_phaseTime * toymod_rotationSpeed
                local targetPos = root.Position + Vector3.new(
                    math.cos(angle) * toymod_orbitRadius,
                    0,
                    math.sin(angle) * toymod_orbitRadius
                )
                local bv = objData.part:FindFirstChild("BodyVelocity")
                if bv then bv.Velocity = (targetPos - objData.part.Position) * 10 end
            end

        elseif toymod_phase == "surround" then
            local count = #toymod_poops
            local phi   = math.pi * (math.sqrt(5) - 1)
            for i, objData in ipairs(toymod_poops) do
                local baseY     = 1 - (i / math.max(count - 1, 1)) * 2
                local radiusAtY = math.sqrt(math.max(0, 1 - baseY * baseY))
                local theta     = phi * i + toymod_phaseTime * toymod_rotationSpeed
                local x = math.cos(theta) * radiusAtY
                local z = math.sin(theta) * radiusAtY
                local targetPos = root.Position + Vector3.new(
                    x * toymod_surroundRadius,
                    baseY * toymod_surroundRadius,
                    z * toymod_surroundRadius
                )
                local bv = objData.part:FindFirstChild("BodyVelocity")
                if bv then bv.Velocity = (targetPos - objData.part.Position) * 10 end
            end

        elseif toymod_phase == "shoot" then
            local dir = root.CFrame.LookVector
            for _, objData in ipairs(toymod_poops) do
                local bv = objData.part:FindFirstChild("BodyVelocity")
                if bv then bv.Velocity = dir * toymod_shootSpeed end
            end
        end
    end)
end

