-- ==================== 毒掴む 追加機能 ====================
local poisonHurtParts = {}
local damageInterval = 0.7
local poisonCoroutine = nil

local function getPoisonHurtParts()
    local parts = {}
    for _, v in ipairs(W:GetDescendants()) do
        if v:IsA("Part") and v.Name == "PoisonHurtPart" then
            table.insert(parts, v)
        end
    end
    return parts
end

local function updatePoisonHurtPartsCache()
    poisonHurtParts = getPoisonHurtParts()
end

local function getGrabbedChar()
    local grabParts = W:FindFirstChild("GrabParts")
    if not grabParts then return nil end
    local grabPart = grabParts:FindFirstChild("GrabPart")
    if not grabPart then return nil end
    local weld = grabPart:FindFirstChild("WeldConstraint")
    if not weld or not weld.Part1 then return nil end
    local part = weld.Part1
    local char = part.Parent
    while char do
        if char:FindFirstChildOfClass("Humanoid") then
            return char
        end
        char = char.Parent
    end
    return nil
end

W.DescendantAdded:Connect(function(inst)
    if inst:IsA("Part") and inst.Name == "PoisonHurtPart" then
        table.insert(poisonHurtParts, inst)
    end
end)
W.DescendantRemoving:Connect(function(inst)
    if inst:IsA("Part") and inst.Name == "PoisonHurtPart" then
        for i, p in ipairs(poisonHurtParts) do
            if p == inst then
                table.remove(poisonHurtParts, i)
                break
            end
        end
    end
end)
updatePoisonHurtPartsCache()
-- ========================================================

local function HRP(plr)
    plr = plr or LP
    local c = plr.Character or plr.CharacterAdded:Wait()
    return c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local c = LP.Character
    if not c then return nil end
    return c:FindFirstChildOfClass("Humanoid")
end

local function getPartFromModel(m)
    return m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
end

local function SetNetworkOwner(part, cframe)
    RS.GrabEvents.SetNetworkOwner:FireServer(part, cframe or HRP().CFrame)
end

local function Velocity(part, value)
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.one * math.huge
    bv.Velocity = value
    bv.Parent = part
    task.delay(1, function() pcall(function() bv:Destroy() end) end)
end

local function MoveTo(part, cframe)
    for _, v in ipairs(part.Parent:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end
    local bp = Instance.new("BodyPosition")
    bp.MaxForce = Vector3.one * math.huge
    bp.Position = typeof(cframe) == "CFrame" and cframe.Position or cframe
    bp.P = 2e4
    bp.D = 5e3
    bp.Parent = part
    task.spawn(function()
        bp.ReachedTarget:Wait()
        pcall(function() bp:Destroy() end)
        for _, v in ipairs(part.Parent:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = true end
        end
    end)
end

local function ungrab(part)
    RS.GrabEvents.DestroyGrabLine:FireServer(part)
end

local function ragdoll()
    RS.CharacterEvents.RagdollRemote:FireServer(HRP(), 0)
end

local function anchor(part)
    local pos = HRP().CFrame
    local tpos = part.CFrame
    for _ = 1, 2 do
        HRP().CFrame = part.CFrame
        SetNetworkOwner(part)
        task.spawn(function()
            task.wait(0.5)
            for _ = 1, 2 do
                task.wait(0.5)
                SetNetworkOwner(part)
                local p = Instance.new("BodyPosition")
                p.Position = part.CFrame.Position
                p.MaxForce = Vector3.one * math.huge
                p.Parent = part
                local r = Instance.new("BodyGyro")
                r.CFrame = tpos
                r.MaxTorque = Vector3.one * math.huge
                r.Parent = part
            end
        end)
        task.wait()
    end
    HRP().CFrame = pos
end

local function spawntoy(name, cframe)
    return RS.MenuToys.SpawnToyRemoteFunction:InvokeServer(name, cframe, Vector3.zero)
end

local function destroyToy(model)
    RS.MenuToys.DestroyToy:FireServer(model)
end

local function getInv()
    return W:FindFirstChild(LP.Name .. "SpawnedInToys")
end

local function getBlobman()
    local inv = getInv()
    if inv then
        local v = inv:FindFirstChild("CreatureBlobman", true)
        if v then return v end
    end
    for _, p in ipairs(W.PlotItems:GetChildren()) do
        local m = p:FindFirstChild("CreatureBlobman")
        if m and m.PlayerValue.Value == LP.Name then
            return m
        end
    end
    return nil
end

local function blobGrab(blob, target, side)
    local args = {
        [1] = blob:FindFirstChild(side .. "Detector"),
        [2] = target,
        [3] = blob:FindFirstChild(side .. "Detector"):FindFirstChild(side .. "Weld")
    }
    blob.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(unpack(args))
end

local function blobDrop(blob, target, side)
    local args = {
        [1] = blob:FindFirstChild(side .. "Detector"),
        [2] = target
    }
    blob.BlobmanSeatAndOwnerScript.CreatureDrop:FireServer(unpack(args))
end

local function blobBring(blob, target, side)
    local pos = HRP().CFrame
    HRP().CFrame = target.CFrame
    task.wait(0.25)
    blobGrab(blob, target, side)
    task.wait(0.25)
    HRP().CFrame = pos
end

local function blobKick(blob, target, side)
    blobGrab(blob, HRP(), side)
    task.wait(0.1)
    SetNetworkOwner(target)
    task.wait()
    target.CFrame = target.CFrame + Vector3.new(0, 16, 0)
    task.wait(0.1)
    ungrab(target)
    blobGrab(blob, target, side)
end

local function Snipefunc(root, func, ...)
    local pos = HRP().CFrame
    task.spawn(function(...)
        local parts = {"Head", "Torso", "HumanoidRootPart"}
        for _, p in pairs(parts) do
            local part = LP.Character:FindFirstChild(p)
            if part then part.CanCollide = false end
        end
        HRP().CFrame = CFrame.new(root.Position - root.CFrame.LookVector * 15)
        task.wait(0.1)
        W.CurrentCamera.CFrame = CFrame.lookAt(W.CurrentCamera.CFrame.Position, root.Position)
        for _ = 1, 4 do SetNetworkOwner(root) task.wait(0.05) end
        local look = W.CurrentCamera.CFrame
        task.wait(0.1)
        func(...)
        W.CurrentCamera.CFrame = look
        task.wait(0.1)
        for _, p in pairs(parts) do
            local part = LP.Character:FindFirstChild(p)
            if part then part.CanCollide = true end
        end
        HRP().CFrame = pos
        Velocity(HRP(), Vector3.zero)
    end, ...)
end

local function getPlayerList()
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP then
            table.insert(list, p.DisplayName)
        end
    end
    return list
end

local function getPlayerFromDisplayName(displayName)
    for _, p in pairs(Players:GetPlayers()) do
        if p.DisplayName == displayName then
            return p
        end
    end
    return nil
end

