        vu467.Conn = vu467.RS.Heartbeat:Connect(function()
            if vu467.A then
                Next()
                if vu467.Cam then
                    local v494 = vu467.W.CurrentCamera
                    v494.CameraType = Enum.CameraType.Scriptable
                    v494.CFrame = vu467.Cam
                    vu467.CB.CFrame = vu467.Cam
                    vu467.CB.Parent = vu467.W
                end
            end
        end)
    end
end
