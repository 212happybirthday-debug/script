local CharacterEvents = RS:FindFirstChild("CharacterEvents")
local Struggle = CharacterEvents and CharacterEvents:FindFirstChild("Struggle")
local RagdollRemote = CharacterEvents and CharacterEvents:FindFirstChild("RagdollRemote")
local GrabEvents = RS:FindFirstChild("GrabEvents")
local SetNetworkOwnerRemote = GrabEvents and GrabEvents:FindFirstChild("SetNetworkOwner")
local DestroyGrabLine = GrabEvents and GrabEvents:FindFirstChild("DestroyGrabLine")
local MenuToys = RS:FindFirstChild("MenuToys")
local SpawnToyRemoteFunction = MenuToys and MenuToys:FindFirstChild("SpawnToyRemoteFunction")
local DestroyToyRemote = MenuToys and MenuToys:FindFirstChild("DestroyToy")
local PlayerEvents = RS:FindFirstChild("PlayerEvents")
local StickyPartEvent = PlayerEvents and PlayerEvents:FindFirstChild("StickyPartEvent")

local mapHole = W:FindFirstChild("Map") and W.Map:FindFirstChild("Hole") and W.Map.Hole:FindFirstChild("PoisonBigHole")
local extPart = nil
local originalPos = Vector3.zero
if mapHole then
    extPart = mapHole:FindFirstChild("ExtinguishPart")
    if not extPart then
        extPart = Instance.new("Part")
        extPart.Name = "ExtinguishPart"
        extPart.Size = Vector3.new(4, 1, 4)
        extPart.Anchored = true
        extPart.CanCollide = false
        extPart.Transparency = 1
        extPart.Position = mapHole.Position
        extPart.Parent = mapHole
    end
    originalPos = extPart.Position
end

local function isAlive(plr)
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function CheckForHome(plr)
    if not W.PlotItems.PlayersInPlots:FindFirstChild(plr.Name) then
        return false
    end
    for _, plot in pairs(W.Plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
        if owners then
            for _, v in pairs(owners:GetChildren()) do
                if v.Value == plr.Name then
                    local folder = W.PlotItems:FindFirstChild(plot.Name)
                    if folder then
                        return true, folder
                    end
                end
            end
        end
    end
    return false
end

local function shouldSpawnInPlotNow(plr, houseFolder)
    local plotModel = W.Plots:FindFirstChild(houseFolder.Name)
    if not plotModel then return false end
    local sign = plotModel:FindFirstChild("PlotSign")
    local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
    local timeNum = owners and owners.Value and owners.Value:FindFirstChild("TimeRemainingNum")
    return timeNum and timeNum.Value > 89
end

local function ClearKunai(plr)
    local inv = W:FindFirstChild(plr.Name .. "SpawnedInToys")
    if not inv then return end
    for _, toy in pairs(inv:GetChildren()) do
        if toy.Name == "AntiKick" or toy.Name == config.Anti.KickTool then
            pcall(function() if DestroyToyRemote then DestroyToyRemote:FireServer(toy) end end)
        end
    end
end

local function ApplyPartSafety(part, transparency)
    part.CanTouch = false
    part.CanCollide = false
    part.CanQuery = false
    part.Transparency = transparency
end

local function StickKunai(plr, kunai)
    if not kunai or not kunai:FindFirstChild("StickyPart") then return end
    local hrp = HRP(plr)
    if not hrp then return end
    if kunai:FindFirstChild("SoundPart") then
        local sp = kunai.SoundPart
        if not sp:FindFirstChild("PartOwner") or sp.PartOwner.Value ~= plr.Name then
            if SetNetworkOwnerRemote then SetNetworkOwnerRemote:FireServer(sp, sp.CFrame) end
        end
    end
    local firePart = hrp:FindFirstChild("FirePlayerPart") or hrp:WaitForChild("FirePlayerPart", 5)
    if firePart and StickyPartEvent then
        StickyPartEvent:FireServer(kunai.StickyPart, firePart, CFrame.new(0,0,0) * CFrame.Angles(0, math.rad(90), math.rad(90)))
    end
    for _, obj in pairs(kunai:GetChildren()) do
        if obj:IsA("BasePart") then
            if obj.Name == "Pyramid" then
                ApplyPartSafety(obj, 0)
            else
                ApplyPartSafety(obj, 1)
            end
        end
    end
end

local function SpawnToy(plr, toyName)
    local t0 = tick()
    local canSpawnToy = plr:FindFirstChild("CanSpawnToy")
    if canSpawnToy then
        while not canSpawnToy.Value do
            if not config.Anti.KickShuriken or tick() - t0 > 5 then return nil end
            task.wait(0.1)
        end
    end
    local hrp = HRP(plr)
    if hrp and SpawnToyRemoteFunction then
        task.spawn(function()
            pcall(function()
                SpawnToyRemoteFunction:InvokeServer(toyName, hrp.CFrame * CFrame.new(0,12,20), Vector3.new(0,0,0))
            end)
        end)
    end
    local inPlot, house = CheckForHome(plr)
    local inv = W:FindFirstChild(plr.Name .. "SpawnedInToys")
    if inPlot and house then
        return house:WaitForChild(toyName, 2)
    elseif inv then
        return inv:WaitForChild(toyName, 2)
    end
    return nil
end

local function monitorKunai(plr, kunai)
    repeat
        if kunai and kunai:FindFirstChild("StickyPart") and kunai.StickyPart.CanTouch == true then
            StickKunai(plr, kunai)
            kunai.Name = "AntiKick"
        end
        task.wait(0.3)
    until not kunai or not config.Anti.KickShuriken or not kunai:FindFirstChild("StickyPart") or kunai.StickyPart.CanTouch == false or not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") or (plr.Character.HumanoidRootPart.Position - kunai.StickyPart.Position).Magnitude >= 20
end

local function waitForWeldBreakThenClear(plr, kunai)
    pcall(function()
        repeat task.wait(0.05) until
            not config.Anti.KickShuriken or not plr.Character or not plr.Character:FindFirstChild("Humanoid") or not kunai or not kunai:FindFirstChild("StickyPart") or not kunai.StickyPart:FindFirstChild("StickyWeld") or not kunai.StickyPart.StickyWeld.Part1
        ClearKunai(plr)
    end)
end

local function ForceAttachShuriken()
    if not config.Anti.KickShuriken then return end
    if not isAlive(LP) then return end
    local inv = W:FindFirstChild(LP.Name .. "SpawnedInToys")
    if inv and (inv:FindFirstChild("AntiKick") or inv:FindFirstChild(config.Anti.KickTool)) then return end
    local kunai = SpawnToy(LP, config.Anti.KickTool)
    if kunai then
        kunai.Name = "AntiKick"
        StickKunai(LP, kunai)
    end
end

local function AntiKickLoop()
    while config.Anti.KickShuriken do
        task.wait(0.05)
        if not isAlive(LP) then
            ClearKunai(LP)
            repeat task.wait() until isAlive(LP) or not config.Anti.KickShuriken
            if config.Anti.KickShuriken then ForceAttachShuriken() end
            continue
        end
        local inv = W:FindFirstChild(LP.Name .. "SpawnedInToys")
        local kunai = inv and inv:FindFirstChild("AntiKick")
        if W.PlotItems.PlayersInPlots:FindFirstChild(LP.Name) then
            local inPlot, house = CheckForHome(LP)
            if inPlot and house and shouldSpawnInPlotNow(LP, house) then
                if not kunai then
                    kunai = SpawnToy(LP, config.Anti.KickTool)
                    if kunai then
                        kunai.Name = "AntiKick"
                        StickKunai(LP, kunai)
                    end
                end
            end
        end
        if not kunai then
            if W.PlotItems.PlayersInPlots:FindFirstChild(LP.Name) then continue end
            kunai = SpawnToy(LP, config.Anti.KickTool)
            if not kunai then continue end
            kunai.Name = "AntiKick"
            StickKunai(LP, kunai)
        end
        monitorKunai(LP, kunai)
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not kunai or not kunai:FindFirstChild("StickyPart") or not hrp or (hrp.Position - kunai.StickyPart.Position).Magnitude >= 20 then
            ClearKunai(LP)
        end
        waitForWeldBreakThenClear(LP, kunai)
    end
end

local function AntiGrabFunction(character)
    local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 10)
    local humanoid = character:WaitForChild("Humanoid", 10)
    local head = character:WaitForChild("Head", 10)
    if not (humanoidRootPart and humanoid and head) then return end
    head.ChildAdded:Connect(function(child)
        if child.Name ~= "PartOwner" or not config.Anti.Grab then return end
        humanoid.Sit = false
        if Struggle then Struggle:FireServer(LP) end
        if antiState.ragdollCount < 100 and RagdollRemote then
            RagdollRemote:FireServer(humanoidRootPart, 0)
            antiState.ragdollCount = antiState.ragdollCount + 1
        end
        if not antiState.antiGrabProce then
            antiState.antiGrabProce = true
            humanoidRootPart.Anchored = true
            local isHeld = LP:FindFirstChild("IsHeld")
            while config.Anti.Grab and (not isHeld or not isHeld.Value) do task.wait() end
            local renderConnection = RunService.RenderStepped:Connect(function()
                humanoidRootPart.CFrame += humanoid.MoveDirection * 0.3
            end)
            while config.Anti.Grab and isHeld and isHeld.Value do task.wait() end
            renderConnection:Disconnect()
            humanoidRootPart.Anchored = false
            antiState.antiGrabProce = false
        end
    end)
end

LP.CharacterAdded:Connect(AntiGrabFunction)
if LP.Character then task.spawn(AntiGrabFunction, LP.Character) end

