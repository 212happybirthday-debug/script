Tab1:AddSection({Name = "毒グラブ"})
local poisonToggle = Tab1:AddToggle({
    Name = "ポイズングラブ v2",
    Default = false,
    Callback = function(enabled)
        if poisonCoroutine then
            coroutine.close(poisonCoroutine)
            poisonCoroutine = nil
        end
        if enabled then
            poisonCoroutine = coroutine.create(function()
                while true do
                    task.wait()
                    pcall(function()
                        local char = getGrabbedChar()
                        if not char then return end
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if not hum or hum.Health <= 0 then return end
                        for _, part in pairs(poisonHurtParts) do
                            if part then
                                part.Size = Vector3.new(2, 2, 2)
                                part.Transparency = 1
                                part.Position = char:FindFirstChild("Head") and char.Head.Position or (char.PrimaryPart and char.PrimaryPart.Position or Vector3.zero)
                            end
                        end
                        hum.Health = hum.Health - 2
                    end)
                    task.wait(damageInterval)
                end
            end)
            coroutine.resume(poisonCoroutine)
        else
            for _, part in pairs(poisonHurtParts) do
                if part then
                    part.Position = Vector3.new(0, -200, 0)
                end
            end
        end
    end
})
