    local soundEffect = Instance.new("Sound", attachmentInstance)
    local particleEmitter = Instance.new("ParticleEmitter", attachmentInstance)
    soundEffect.Name = "soundeffect"
    soundEffect.SoundId = "rbxassetid://1091083826"
