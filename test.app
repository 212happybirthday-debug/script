local pvpState = {
    CameraClone = nil,
    CameraInitialized = false,
    HRPs = {},
    Character = nil,
    Humanoid = nil,
    Root = nil,
    GrabbedPart = nil,
    LastGrabbedTarget = nil,
    LastGrabbedTime = 0,
    ReachDistance = 30,
    LastGrabTime = 0,
    GrabCooldown = 0.05
}

local function UpdateCharacter(NewCharacter)
    if not (NewCharacter and NewCharacter:IsDescendantOf(workspace)) then return end
    pvpState.Character = NewCharacter
    pvpState.Humanoid = pvpState.Character:WaitForChild("Humanoid", 3)
    pvpState.Root = pvpState.Character:WaitForChild("HumanoidRootPart", 3)
    local CurrentReach = LP:FindFirstChild("CurrentReach")
    if CurrentReach then
        pvpState.ReachDistance = CurrentReach.Value
    end
    pvpState.HRPs[pvpState.Root] = nil
end

local function IsPlayerTarget(HRP)
    if not HRP or not HRP.Parent then return false end
    local Model = HRP.Parent
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character == Model and player ~= LP then
            return true
        end
    end
    return false
end

local function GetTarget()
    if not config.PvP.SilentAimEnabled then return nil end
    if not pvpState.CameraClone or not pvpState.Root then return nil end

    local Center = Camera.ViewportSize / 2
    local Distance = math.huge
    local Target = nil

    local MaxScreenDistance = (Camera.ViewportSize.X + Camera.ViewportSize.Y) / 2
    local AdjustedStrength = (config.PvP.AimStrength / 100) * MaxScreenDistance

    for HRP in pairs(pvpState.HRPs) do
        if HRP and HRP.Parent and HRP ~= pvpState.Root and HRP:IsDescendantOf(workspace) then
            local Model = HRP.Parent
            local TargetHumanoid = Model:FindFirstChildWhichIsA("Humanoid")
            if TargetHumanoid and TargetHumanoid.Health > 0 then
                local Screen3D, OnScreen = Camera:WorldToScreenPoint(HRP.Position)
                if OnScreen then
                    local Magnitude = (HRP.Position - pvpState.CameraClone.CFrame.Position).Magnitude
                    if Magnitude <= pvpState.ReachDistance then
                        local Screen2D = Vector2.new(Screen3D.X, Screen3D.Y)
                        local ScreenDistance = (Screen2D - Center).Magnitude
                        if ScreenDistance <= AdjustedStrength then
                            if ScreenDistance < Distance then
                                Distance = ScreenDistance
                                Target = HRP
                            end
                        end
                    end
                end
            end
        end
    end
    return Target
end

local function GetAutoGrabTarget()
    if not config.PvP.AutoGrabEnabled then return nil end
    if not Camera or not pvpState.Root then return nil end

    local Center = Camera.ViewportSize / 2
    local Distance = math.huge
    local Target = nil

    local MaxScreenDistance = (Camera.ViewportSize.X + Camera.ViewportSize.Y) / 2
    local AdjustedStrength = (config.PvP.AimStrength / 100) * MaxScreenDistance

    for HRP in pairs(pvpState.HRPs) do
        if HRP and HRP.Parent and HRP ~= pvpState.Root and HRP:IsDescendantOf(workspace) then
            if IsPlayerTarget(HRP) then
                local Model = HRP.Parent
                local TargetHumanoid = Model:FindFirstChildWhichIsA("Humanoid")
                if TargetHumanoid and TargetHumanoid.Health > 0 then
                    local Screen3D, OnScreen = Camera:WorldToScreenPoint(HRP.Position)
                    if OnScreen then
                        local Magnitude = (HRP.Position - Camera.CFrame.Position).Magnitude
                        if Magnitude <= pvpState.ReachDistance then
                            local Screen2D = Vector2.new(Screen3D.X, Screen3D.Y)
                            local ScreenDistance = (Screen2D - Center).Magnitude
                            if ScreenDistance <= AdjustedStrength * 0.9 then
                                if ScreenDistance < Distance then
                                    Distance = ScreenDistance
                                    Target = HRP
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return Target
end

