local function getPlayers()
local t={}
for _,p in pairs(Players:GetPlayers()) do
if p~=LocalPlayer then
table.insert(t,p.DisplayName.." (@"..p.Name..")")
end
end
return t
end

local Dropdown = Tab:AddDropdown({
Name="プレイヤー選択",
Options=getPlayers(),
Callback=function(v)

local username=v:match("@(.+)%)")
selectedPlayer=username

local p=Players:FindFirstChild(username)
if p then
Label:Set("選択中",p.DisplayName.." @"..p.Name)
end

end
})

Tab:AddButton({
Name="キック",
Callback=function()

if not selectedPlayer then return end

local target=Players:FindFirstChild(selectedPlayer)
if not target then return end

local root=target.Character and target.Character:FindFirstChild("HumanoidRootPart")
if not root then return end

local blob=BlobmanBeta.getBlobman() or BlobmanBeta.spawnBlobman()
BlobmanBeta.ensureSitBlobman()

local my=BlobmanBeta.getLocalRoot()
local old=my.CFrame

my.CFrame=root.CFrame
task.wait(.07)

BlobmanBeta.blobKick(blob,root,"Left")

task.wait(.25)
my.CFrame=old

BlobmanBeta.destroyBlobman()

end
})

