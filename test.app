-- ================= Invincibility追加機能 (Megahub版) =================

local megaRS = game:GetService("ReplicatedStorage")
local megaCharEvents = megaRS:WaitForChild("CharacterEvents")
local megaGrabEvents = megaRS:WaitForChild("GrabEvents")
local megaMenuToys   = megaRS:WaitForChild("MenuToys")
local megaPlayerEvents = megaRS:WaitForChild("PlayerEvents")
local megaRagdollRemote      = megaCharEvents:WaitForChild("RagdollRemote")
local megaStruggle           = megaCharEvents:WaitForChild("Struggle")
local megaSetNetworkOwner    = megaGrabEvents:WaitForChild("SetNetworkOwner")
local megaSpawnToyRF         = megaMenuToys:WaitForChild("SpawnToyRemoteFunction")
local megaBuyToyRF           = megaMenuToys:WaitForChild("BuyToyRemoteFunction")
local megaDestroyToy         = megaMenuToys:WaitForChild("DestroyToy")
local megaStickyPartEvent    = megaPlayerEvents:WaitForChild("StickyPartEvent")
local megaCharacterAndBeamMove = LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("CharacterAndBeamMove")
local megaSpawnedInToys      = workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys")
local megaPlayerGui          = LocalPlayer:WaitForChild("PlayerGui")
local megaPaintPartsBackup   = {}
local megaPaintConnections   = {}
local megaAntiKickCoroutine  = nil
local megaAntikickV2         = false
local megaNotifiedNoCoins    = false
local megaProtectionEnabled  = false
local megaProtConnections    = {}
local megaCharAddedConn      = nil

local function megaNBNotification(msg)
    OrionLib:MakeNotification({
        Name = "波 hub🌊",
        Content = msg,
        Image = "rbxassetid://4483345998",
        Time = 5
    })
end

local megaInvSection2 = InvincibilityTab:AddSection({ Name = "Anti-Kick" })
local megaInvSection3 = InvincibilityTab:AddSection({ Name = "Anti-Ragdoll / Anti-Paint" })

-- Anti-Kick-Grab
megaInvSection2:AddToggle({
    Name = "Anti-Kick-Grab",
    Default = false,
    Callback = function(enabled)
        if enabled then
            megaAntiKickCoroutine = game:GetService("RunService").Heartbeat:Connect(function()
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart")
                    and character.HumanoidRootPart:FindFirstChild("FirePlayerPart") then
                    local partOwner = character.HumanoidRootPart.FirePlayerPart:FindFirstChild("PartOwner")
                    if partOwner and partOwner.Value ~= LocalPlayer.Name then
                        local args = { character:WaitForChild("HumanoidRootPart"), 0 }
                        megaRagdollRemote:FireServer(unpack(args))
                        wait(0.1)
                        megaStruggle:FireServer()
                    end
                end
            end)
        else
            if megaAntiKickCoroutine then
                megaAntiKickCoroutine:Disconnect()
                megaAntiKickCoroutine = nil
            end
        end
    end,
    Save = true,
    Flag = "mega_antikickgrab_toggle"
})

-- Anti-Kick (NinjaKunaiで足を守るV2)
megaInvSection2:AddToggle({
    Name = "Anti-Kick (V2)",
    Default = false,
    Callback = function(Value)
        local ToyContents = megaPlayerGui:WaitForChild("MenuGui"):WaitForChild("Menu")
            :WaitForChild("TabContents"):WaitForChild("Toys"):WaitForChild("Contents")

        megaAntikickV2 = Value
        if Value then megaNotifiedNoCoins = false end

        local function getCharPart(name)
            local char = LocalPlayer.Character
            return char and char:FindFirstChild(name)
        end

        local function inner_toyspn(toyName, cf)
            megaSpawnToyRF:InvokeServer(toyName, cf, Vector3.new(0, 0, 0))
        end

        local function inner_toyspn2(toyName)
            local hrp = getCharPart("HumanoidRootPart")
            if hrp then
                local cf = hrp.CFrame
                inner_toyspn(toyName, cf - Vector3.new(cf.LookVector.X * 20, -15, cf.LookVector.Z * 20))
            end
        end

        local function f()
            local character = LocalPlayer.Character
            if not character then return end
            local hrp = character:FindFirstChild("HumanoidRootPart")
            local hum = character:FindFirstChildOfClass("Humanoid")
            local leg = character:FindFirstChild("Right Leg")
            if not hrp or not hum or not leg or hum.Health <= 0 then return end
            if LocalPlayer.InPlot.Value then return end

            if not ToyContents:FindFirstChild("NinjaKunai") then
                local success = megaBuyToyRF:InvokeServer("NinjaKunai")
                if not success then
                    if not megaNotifiedNoCoins then
                        megaNBNotification("NinjaKunaiを購入できません（コイン不足）")
                        megaNotifiedNoCoins = true
                    end
                    return
                end
            end

            local kunai = megaSpawnedInToys:FindFirstChild("NinjaKunai")
            if kunai then
                local sticky = kunai:WaitForChild("StickyPart", 1)
                if sticky then
                    local weld = sticky:FindFirstChild("StickyWeld")
                    local attachedPart = weld and weld.Part1
                    if not weld or attachedPart ~= leg then
                        megaDestroyToy:FireServer(kunai)
                        task.wait(0.1)
                    end
                else
                    megaDestroyToy:FireServer(kunai)
                    task.wait(0.1)
                end
            elseif LocalPlayer.CanSpawnToy.Value then
                task.spawn(inner_toyspn2, "NinjaKunai")
                local newKunai = megaSpawnedInToys:WaitForChild("NinjaKunai", 3)
                if newKunai then
                    local sticky = newKunai:WaitForChild("StickyPart", 2)
                    if sticky then
                        local weld = sticky:WaitForChild("StickyWeld", 2)
                        megaSetNetworkOwner:FireServer(sticky, sticky.CFrame)
                        local retry = 0
                        while megaAntikickV2 and weld.Part1 == nil and retry < 20 do
                            megaStickyPartEvent:FireServer(sticky, leg,
                                CFrame.new(0.0490287527, 0.5, 0, 0, 0.00739139877, -0.999561906,
                                    -0.998452604, -0.0478846952, 0.0282763243,
                                    -0.0476547107, 0.99882561, 0) * CFrame.Angles(0, 0, 0))
                            task.wait(0.1)
                            retry = retry + 1
                        end
                    end
                end
            end
        end

        if megaAntikickV2 then
            task.spawn(function()
                while megaAntikickV2 do
                    pcall(f)
                    task.wait()
                end
            end)
        end
    end,
    Save = true,
    Flag = "mega_antikickv2_toggle"
})

-- Anti-Kick (旧式 - シンプル版)
